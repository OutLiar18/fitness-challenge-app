rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPlatformAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasPlatformAdminProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isPlatformAdmin() {
      return hasPlatformAdminClaim() || hasPlatformAdminProfile();
    }

    function hasLeagueAdminProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "leagueAdmin";
    }

    function isLeagueOperator() {
      return isPlatformAdmin() || hasLeagueAdminProfile();
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isLeagueMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + request.auth.uid));
    }

    function isLeagueAdministrator(leagueId) {
      return isPlatformAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/leagues/$(leagueId))
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.administratorIds
        );
    }

    function managesLeagueAfter(leagueId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/leagues/$(leagueId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.administratorIds;
    }

    function canCreateScopedAuditEvent() {
      return isPlatformAdmin()
        || (
          request.resource.data.entityType == "league"
          && (
            isLeagueAdministrator(request.resource.data.entityId)
            || managesLeagueAfter(request.resource.data.entityId)
          )
        );
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        "legacy-trophy",
        "phoenix-rise",
        "iron-shield",
        "storm-runner",
        "wild-lion",
        "night-wolf",
        "wisdom-keeper",
        "water-guardian",
        "forge-master",
        "summit-falcon",
        "ember-heart",
        "crowned-champion"
      ];
    }

    function validRole(role) {
      return role in ["user", "leagueAdmin", "admin"];
    }

    function validAuditAfter(auditId, entityType, entityId) {
      let audit = getAfter(
        /databases/$(database)/documents/auditEvents/$(auditId)
      ).data;

      return audit.actorId == request.auth.uid
        && audit.entityType == entityType
        && audit.entityId == entityId
        && audit.createdAt == request.time;
    }

    function validAuditEvent() {
      return request.resource.data.keys().hasOnly([
          "actorId",
          "action",
          "entityType",
          "entityId",
          "summary",
          "details",
          "createdAt"
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 100
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() >= 2
        && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() >= 1
        && request.resource.data.entityId.size() <= 200
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 4
        && request.resource.data.summary.size() <= 300
        && request.resource.data.details is map
        && request.resource.data.createdAt == request.time;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "firstName",
          "lastName",
          "fullName",
          "displayName",
          "email",
          "role",
          "team",
          "avatarId",
          "joinedAt",
          "profileUpdatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.fullName is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.role == "user"
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 80
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.profileUpdatedAt is timestamp;
    }

    function validPlayerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "avatarId",
          "profileUpdatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.profileUpdatedAt == request.time;
    }

    function validAdministratorUserUpdate(userId) {
      return request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "team",
          "adminUpdatedAt",
          "adminUpdatedBy",
          "lastAuditId"
        ])
        && validRole(request.resource.data.role)
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 80
        && request.resource.data.adminUpdatedAt == request.time
        && request.resource.data.adminUpdatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "user",
          userId
        );
    }

    function validLibraryItem() {
      return request.resource.data.itemType is string
        && request.resource.data.usageCount is int
        && request.resource.data.usageCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validChallengeEntry() {
      return request.resource.data.keys().hasOnly([
          "userId",
          "category",
          "data",
          "createdAt",
          "challengeDate"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category in [
          "water",
          "fruit",
          "reading",
          "running",
          "upperBody",
          "lowerBody",
          "core",
          "cardio",
          "skill",
          "steps"
        ]
        && request.resource.data.data is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.challengeDate is timestamp;
    }

    function validExerciseSuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "exerciseDefinition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.exerciseDefinition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validLibrarySuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "itemType",
          "definition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.itemType in ["cardio", "skill"]
        && request.resource.data.definition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validSuggestionReview(entityType, suggestionId) {
      return resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason",
          "lastAuditId"
        ])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() <= 500
        && (
          request.resource.data.status == "approved"
          || request.resource.data.rejectionReason.size() >= 4
        )
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          entityType,
          suggestionId
        );
    }

    function validAnnouncementData() {
      return request.resource.data.keys().hasOnly([
          "title",
          "summary",
          "body",
          "type",
          "icon",
          "status",
          "featured",
          "version",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "publishedAt",
          "lastAuditId"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 90
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 10
        && request.resource.data.summary.size() <= 220
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 20
        && request.resource.data.body.size() <= 4000
        && request.resource.data.type in [
          "release",
          "feature",
          "challenge",
          "community",
          "maintenance"
        ]
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 8
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.featured is bool
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && (
          request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp
        )
        && (
          request.resource.data.status != "published"
          || (
            request.resource.data.publishedAt is timestamp
            && request.resource.data.publishedAt <= request.time
          )
        )
        && request.resource.data.lastAuditId is string;
    }

    function validAnnouncementCreate(announcementId) {
      return validAnnouncementData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "announcement",
          announcementId
        );
    }

    function validAnnouncementUpdate(announcementId) {
      return validAnnouncementData()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          resource.data.status != "published"
            && request.resource.data.status == "published"
            ? request.resource.data.publishedAt == request.time
            : request.resource.data.publishedAt == resource.data.publishedAt
        )
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "announcement",
          announcementId
        );
    }

    function validAnnouncementRead(announcementId) {
      return request.resource.data.keys().hasOnly([
          "announcementId",
          "readAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.readAt == request.time;
    }


    function validSuggestionPublish(entityType, suggestionId) {
      return resource.data.status == "approved"
        && resource.data.get("publicationStatus", "unpublished") != "published"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "publicationStatus",
          "publishedAt",
          "publishedBy",
          "publishedLibraryItemId",
          "libraryVersion",
          "lastAuditId"
        ])
        && request.resource.data.publicationStatus == "published"
        && request.resource.data.publishedAt == request.time
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.publishedLibraryItemId is string
        && request.resource.data.publishedLibraryItemId.size() >= 3
        && request.resource.data.publishedLibraryItemId.size() <= 160
        && request.resource.data.libraryVersion is string
        && request.resource.data.libraryVersion.size() >= 5
        && request.resource.data.libraryVersion.size() <= 40
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          entityType,
          suggestionId
        );
    }

    function validPublishedLibraryItemCreate(itemId) {
      return request.resource.data.keys().hasOnly([
          "itemType",
          "name",
          "normalizedName",
          "definition",
          "status",
          "libraryVersion",
          "sourceSuggestionId",
          "sourceCollection",
          "releaseId",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "publishedAt",
          "archivedAt",
          "lastAuditId"
        ])
        && request.resource.data.itemType in ["exercise", "cardio", "skill"]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName.size() >= 2
        && request.resource.data.normalizedName.size() <= 140
        && request.resource.data.definition is map
        && request.resource.data.status == "published"
        && request.resource.data.libraryVersion is string
        && request.resource.data.libraryVersion.size() >= 5
        && request.resource.data.libraryVersion.size() <= 40
        && request.resource.data.sourceSuggestionId is string
        && request.resource.data.sourceSuggestionId.size() >= 1
        && request.resource.data.sourceCollection in [
          "exerciseSuggestions",
          "librarySuggestions"
        ]
        && request.resource.data.releaseId is string
        && request.resource.data.releaseId.size() >= 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && request.resource.data.archivedAt == null
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "publishedLibraryItem",
          itemId
        );
    }

    function validPublishedLibraryItemArchive(itemId) {
      return resource.data.status == "published"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "updatedBy",
          "archivedAt",
          "lastAuditId"
        ])
        && request.resource.data.status == "archived"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "publishedLibraryItem",
          itemId
        );
    }

    function validLibraryReleaseCreate(releaseId) {
      return request.resource.data.keys().hasOnly([
          "version",
          "notes",
          "status",
          "itemIds",
          "itemCount",
          "createdAt",
          "createdBy",
          "publishedAt",
          "lastAuditId"
        ])
        && request.resource.data.version is string
        && request.resource.data.version.size() >= 5
        && request.resource.data.version.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() >= 10
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.status == "published"
        && request.resource.data.itemIds is list
        && request.resource.data.itemIds.size() >= 1
        && request.resource.data.itemIds.size() <= 8
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount == request.resource.data.itemIds.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "libraryRelease",
          releaseId
        );
    }

    function validClientErrorReportCreate() {
      return request.resource.data.keys().hasOnly([
          "name",
          "message",
          "stack",
          "source",
          "route",
          "releaseVersion",
          "context",
          "userAgent",
          "occurredAt",
          "fingerprint",
          "userId",
          "status",
          "reportedAt",
          "resolvedAt",
          "resolvedBy",
          "resolutionNote",
          "lastAuditId"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 600
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 4000
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 120
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 300
        && request.resource.data.releaseVersion is string
        && request.resource.data.releaseVersion.size() <= 40
        && request.resource.data.context is map
        && request.resource.data.context.keys().hasOnly(["summary"])
        && request.resource.data.context.summary is string
        && request.resource.data.context.summary.size() <= 1000
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() >= 3
        && request.resource.data.fingerprint.size() <= 500
        && request.resource.data.status == "open"
        && request.resource.data.reportedAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == ""
        && request.resource.data.resolutionNote == ""
        && request.resource.data.lastAuditId == "";
    }

    function validClientErrorReportResolve(reportId) {
      return resource.data.status == "open"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "resolvedAt",
          "resolvedBy",
          "resolutionNote",
          "lastAuditId"
        ])
        && request.resource.data.status == "resolved"
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolutionNote is string
        && request.resource.data.resolutionNote.size() >= 4
        && request.resource.data.resolutionNote.size() <= 500
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "clientErrorReport",
          reportId
        );
    }

    function validTeamEmblemId(emblemId) {
      return emblemId in [
        "legacy-banner",
        "iron-shield",
        "rising-phoenix",
        "summit",
        "lion-heart",
        "storm",
        "oak",
        "compass"
      ];
    }

    function validTeamCreate(teamId) {
      return request.resource.data.keys().hasOnly([
          "name",
          "normalizedName",
          "description",
          "motto",
          "emblemId",
          "status",
          "captainId",
          "memberCount",
          "inviteCode",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 48
        && request.resource.data.normalizedName is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 240
        && request.resource.data.motto is string
        && request.resource.data.motto.size() >= 3
        && request.resource.data.motto.size() <= 90
        && validTeamEmblemId(request.resource.data.emblemId)
        && request.resource.data.status == "active"
        && request.resource.data.captainId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "captain"
        && getAfter(/databases/$(database)/documents/playerTeams/$(request.auth.uid)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteCode)).data.teamId == teamId;
    }

    function validTeamUpdate() {
      return request.auth.uid == resource.data.captainId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "description",
          "motto",
          "emblemId",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 240
        && request.resource.data.motto is string
        && request.resource.data.motto.size() >= 3
        && request.resource.data.motto.size() <= 90
        && validTeamEmblemId(request.resource.data.emblemId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validTeamMemberCountUpdate(teamId) {
      let memberBefore = exists(
        /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
      );
      let memberAfter = existsAfter(
        /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
      );

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberCount",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberCount <= 25
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (
            !memberBefore
            && memberAfter
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && getAfter(
              /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
            ).data.role == "member"
          )
          || (
            memberBefore
            && !memberAfter
            && get(
              /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
            ).data.role == "member"
            && request.resource.data.memberCount == resource.data.memberCount - 1
          )
        );
    }

    function validTeamCaptainTransfer(teamId) {
      return request.auth.uid == resource.data.captainId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "captainId",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.captainId is string
        && request.resource.data.captainId != request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.captainId)
        ).data.role == "captain"
        && getAfter(
          /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)
        ).data.role == "member"
        && getAfter(
          /databases/$(database)/documents/playerTeams/$(request.resource.data.captainId)
        ).data.role == "captain"
        && getAfter(
          /databases/$(database)/documents/playerTeams/$(request.auth.uid)
        ).data.role == "member";
    }

    function validTeamMemberRoleTransfer(teamId, userId) {
      let teamBefore = get(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;
      let teamAfter = getAfter(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;

      return (
          request.auth.uid == resource.data.userId
          || request.auth.uid == teamBefore.captainId
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
        && request.resource.data.role in ["captain", "member"]
        && (
          (
            userId == teamAfter.captainId
            && request.resource.data.role == "captain"
          )
          || (
            userId == request.auth.uid
            && resource.data.role == "captain"
            && request.resource.data.role == "member"
            && teamAfter.captainId != userId
          )
        );
    }

    function validPlayerTeamRoleTransfer(userId) {
      let teamId = resource.data.teamId;
      let teamAfter = getAfter(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;

      return request.auth.uid == get(
          /databases/$(database)/documents/teams/$(teamId)
        ).data.captainId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
        && request.resource.data.role in ["captain", "member"]
        && (
          (
            userId == teamAfter.captainId
            && request.resource.data.role == "captain"
          )
          || (
            userId == request.auth.uid
            && resource.data.role == "captain"
            && request.resource.data.role == "member"
            && teamAfter.captainId != userId
          )
        );
    }

    function validTeamInviteCreate(code) {
      return request.resource.data.keys().hasOnly([
          "teamId",
          "teamName",
          "emblemId",
          "status",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ])
        && code.size() == 8
        && request.resource.data.teamId is string
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() >= 3
        && request.resource.data.teamName.size() <= 48
        && validTeamEmblemId(request.resource.data.emblemId)
        && request.resource.data.status == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.captainId == request.auth.uid;
    }

    function validTeamMemberCreate(teamId, userId) {
      return request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "userId",
          "displayName",
          "avatarId",
          "role",
          "inviteCode",
          "joinedAt",
          "weeklyKey",
          "weeklyPoints",
          "activeDays",
          "entriesRecorded",
          "currentStreak",
          "progressUpdatedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.role in ["captain", "member"]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.joinedAt == request.time
        && request.resource.data.weeklyKey == ""
        && request.resource.data.weeklyPoints == 0
        && request.resource.data.activeDays == 0
        && request.resource.data.entriesRecorded == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.progressUpdatedAt == request.time
        && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteCode)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteCode)).data.status == "active"
        && getAfter(/databases/$(database)/documents/playerTeams/$(userId)).data.teamId == teamId
        && (
          (
            request.resource.data.role == "captain"
            && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.captainId == userId
            && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.memberCount == 1
          )
          || (
            request.resource.data.role == "member"
            && get(/databases/$(database)/documents/teams/$(teamId)).data.status == "active"
            && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.memberCount
              == get(/databases/$(database)/documents/teams/$(teamId)).data.memberCount + 1
          )
        );
    }

    function validTeamMemberProgressUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "avatarId",
          "weeklyKey",
          "weeklyPoints",
          "activeDays",
          "entriesRecorded",
          "currentStreak",
          "progressUpdatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.weeklyKey is string
        && request.resource.data.weeklyKey.size() <= 10
        && request.resource.data.weeklyPoints is number
        && request.resource.data.weeklyPoints >= 0
        && request.resource.data.weeklyPoints <= 100000
        && request.resource.data.activeDays is int
        && request.resource.data.activeDays >= 0
        && request.resource.data.activeDays <= 7
        && request.resource.data.entriesRecorded is int
        && request.resource.data.entriesRecorded >= 0
        && request.resource.data.entriesRecorded <= 1000
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 0
        && request.resource.data.currentStreak <= 100000
        && request.resource.data.progressUpdatedAt == request.time;
    }

    function validPlayerTeamCreate(userId) {
      return request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "userId",
          "teamId",
          "teamName",
          "emblemId",
          "role",
          "joinedAt"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.teamId is string
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() >= 3
        && request.resource.data.teamName.size() <= 48
        && validTeamEmblemId(request.resource.data.emblemId)
        && request.resource.data.role in ["captain", "member"]
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(userId)).data.role == request.resource.data.role;
    }

    function validCoachPreferences() {
      return request.resource.data.keys().hasOnly([
          "enabled",
          "tone",
          "focus",
          "updatedAt"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.tone in ["gentle", "balanced", "direct"]
        && request.resource.data.focus in ["balanced", "consistency", "fitness", "learning"]
        && request.resource.data.updatedAt == request.time;
    }

    function validLeagueRuleset(ruleset) {
      return ruleset is map
        && ruleset.keys().hasOnly([
          "version",
          "scoringEngineVersion",
          "dailyActivityCap",
          "dailyParticipationBonus",
          "includedCategories"
        ])
        && ruleset.version == "consistency-v1"
        && ruleset.scoringEngineVersion == "points-v2"
        && ruleset.dailyActivityCap == 20
        && ruleset.dailyParticipationBonus == 5
        && ruleset.includedCategories is list
        && ruleset.includedCategories.size() == 10
        && ruleset.includedCategories.hasAll([
          "water",
          "fruit",
          "reading",
          "running",
          "upperBody",
          "lowerBody",
          "core",
          "cardio",
          "skill",
          "steps"
        ]);
    }

    function validLeagueTransition(currentStatus, nextStatus) {
      return (currentStatus == "draft" && nextStatus == "registration")
        || (currentStatus == "registration" && nextStatus == "active")
        || (currentStatus == "active" && nextStatus == "completed")
        || (currentStatus == "completed" && nextStatus == "archived");
    }

    function validLeagueCreate(leagueId) {
      return request.resource.data.keys().hasOnly([
          "name",
          "normalizedName",
          "description",
          "type",
          "mode",
          "status",
          "startDate",
          "endDate",
          "rulesVersion",
          "ruleset",
          "administratorIds",
          "inviteCode",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "activatedAt",
          "completedAt",
          "archivedAt",
          "lastAuditId"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 4
        && request.resource.data.name.size() <= 70
        && request.resource.data.normalizedName is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 400
        && request.resource.data.type in [
          "Friends",
          "Family",
          "Workplace",
          "School",
          "Community",
          "Charity",
          "Tournament"
        ]
        && request.resource.data.mode in ["individual", "team"]
        && request.resource.data.status == "draft"
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate > request.resource.data.startDate
        && request.resource.data.rulesVersion == "consistency-v1"
        && validLeagueRuleset(request.resource.data.ruleset)
        && request.resource.data.administratorIds is list
        && request.resource.data.administratorIds.size() == 1
        && request.auth.uid in request.resource.data.administratorIds
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.activatedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.archivedAt == null
        && request.resource.data.lastAuditId is string
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId)
        && getAfter(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.leagueId == leagueId;
    }

    function validLeagueStatusUpdate(leagueId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "updatedBy",
          "activatedAt",
          "completedAt",
          "archivedAt",
          "lastAuditId"
        ])
        && validLeagueTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId)
        && (
          request.resource.data.status != "active"
          || request.resource.data.activatedAt == request.time
        )
        && (
          request.resource.data.status != "completed"
          || request.resource.data.completedAt == request.time
        )
        && (
          request.resource.data.status != "archived"
          || request.resource.data.archivedAt == request.time
        );
    }

    function validLeagueInviteCreate(code) {
      return request.resource.data.keys().hasOnly([
          "leagueId",
          "leagueName",
          "status",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ])
        && code.size() == 8
        && request.resource.data.leagueId is string
        && request.resource.data.leagueName is string
        && request.resource.data.status == "closed"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && managesLeagueAfter(request.resource.data.leagueId);
    }

    function validLeagueInviteUpdate() {
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (leagueAfter.status == "registration" && request.resource.data.status == "active")
          || (leagueAfter.status != "registration" && request.resource.data.status == "closed")
        );
    }

    function validLeagueMembershipCreate(membershipId) {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let playerHasTeam = exists(
        /databases/$(database)/documents/playerTeams/$(request.auth.uid)
      );

      return request.resource.data.keys().hasOnly([
          "leagueId",
          "userId",
          "displayName",
          "avatarId",
          "teamId",
          "teamName",
          "role",
          "status",
          "inviteCode",
          "joinedAt",
          "updatedAt"
        ])
        && membershipId == request.resource.data.leagueId + "_" + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.teamId is string
        && request.resource.data.teamId.size() <= 200
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() >= 2
        && request.resource.data.teamName.size() <= 80
        && request.resource.data.role == "participant"
        && request.resource.data.status == "registered"
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time
        && league.status == "registration"
        && (league.mode != "team" || playerHasTeam)
        && (
          (
            playerHasTeam
            && request.resource.data.teamId
              == get(/databases/$(database)/documents/playerTeams/$(request.auth.uid)).data.teamId
            && request.resource.data.teamName
              == get(/databases/$(database)/documents/playerTeams/$(request.auth.uid)).data.teamName
          )
          || (
            !playerHasTeam
            && request.resource.data.teamId == ""
            && request.resource.data.teamName == "Independent"
          )
        )
        && get(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.leagueId == request.resource.data.leagueId
        && get(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.status == "active";
    }

    function validLeagueMembershipStatusUpdate() {
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && (
          (leagueAfter.status == "active" && request.resource.data.status == "active")
          || (
            leagueAfter.status in ["completed", "archived"]
            && request.resource.data.status == "completed"
          )
        );
    }

    function validLeagueContributionCreate(contributionId) {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      let entry = getAfter(
        /databases/$(database)/documents/challengeEntries/$(request.resource.data.entryId)
      ).data;

      return request.resource.data.keys().hasOnly([
          "leagueId",
          "entryId",
          "userId",
          "displayName",
          "avatarId",
          "teamId",
          "teamName",
          "category",
          "challengeDate",
          "activityPoints",
          "rulesVersion",
          "createdAt"
        ])
        && contributionId == request.resource.data.leagueId + "_" + request.resource.data.entryId
        && request.resource.data.userId == request.auth.uid
        && membership.userId == request.auth.uid
        && membership.status == "active"
        && league.status == "active"
        && request.resource.data.rulesVersion == league.rulesVersion
        && request.resource.data.displayName == membership.displayName
        && request.resource.data.avatarId == membership.avatarId
        && request.resource.data.teamId == membership.teamId
        && request.resource.data.teamName == membership.teamName
        && entry.userId == request.auth.uid
        && request.resource.data.category == entry.category
        && request.resource.data.category in league.ruleset.includedCategories
        && request.resource.data.challengeDate == entry.challengeDate
        && request.resource.data.challengeDate >= league.startDate
        && request.resource.data.challengeDate <= league.endDate
        && request.resource.data.activityPoints is number
        && request.resource.data.activityPoints >= 0
        && request.resource.data.activityPoints <= 10000
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validUserProfile(userId);
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow update: if (
        isOwner(userId) && validPlayerProfileUpdate()
      ) || (
        isPlatformAdmin() && validAdministratorUserUpdate(userId)
      );
      allow delete: if false;
    }

    match /users/{userId}/library/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validLibraryItem();
      allow update: if isOwner(userId)
        && validLibraryItem()
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /users/{userId}/announcementReads/{announcementId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validAnnouncementRead(announcementId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/coach/{documentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && documentId == "preferences"
        && validCoachPreferences();
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/playerTeams/$(request.auth.uid))
        && validTeamCreate(teamId);
      allow read: if isPlatformAdmin() || isTeamMember(teamId);
      allow update: if signedIn()
        && (
          validTeamUpdate()
          || validTeamCaptainTransfer(teamId)
          || validTeamMemberCountUpdate(teamId)
        );
      allow delete: if false;
    }

    match /teams/{teamId}/members/{userId} {
      allow read: if isPlatformAdmin() || isTeamMember(teamId);
      allow create: if signedIn() && validTeamMemberCreate(teamId, userId);
      allow update: if signedIn()
        && (
          (isOwner(userId) && validTeamMemberProgressUpdate())
          || validTeamMemberRoleTransfer(teamId, userId)
        );
      allow delete: if isOwner(userId)
        && resource.data.role != "captain"
        && !existsAfter(/databases/$(database)/documents/playerTeams/$(userId))
        && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.memberCount
          == get(/databases/$(database)/documents/teams/$(teamId)).data.memberCount - 1;
    }

    match /playerTeams/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/playerTeams/$(userId))
        && validPlayerTeamCreate(userId);
      allow update: if signedIn() && validPlayerTeamRoleTransfer(userId);
      allow delete: if isOwner(userId)
        && !existsAfter(
          /databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(userId)
        );
    }

    match /teamInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && validTeamInviteCreate(code);
      allow update, delete: if false;
    }

    match /leagues/{leagueId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(leagueId)
        || (
          signedIn()
          && resource.data.status in ["registration", "active", "completed", "archived"]
        );
      allow create: if isLeagueOperator() && validLeagueCreate(leagueId);
      allow update: if isLeagueAdministrator(leagueId)
        && validLeagueStatusUpdate(leagueId);
      allow delete: if false;
    }

    match /leagueInvites/{code} {
      allow read: if signedIn();
      allow create: if isLeagueOperator() && validLeagueInviteCreate(code);
      allow update: if isLeagueAdministrator(resource.data.leagueId)
        && validLeagueInviteUpdate();
      allow delete: if false;
    }

    match /leagueMemberships/{membershipId} {
      allow read: if isPlatformAdmin()
        || resource.data.userId == request.auth.uid
        || isLeagueMember(resource.data.leagueId)
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validLeagueMembershipCreate(membershipId);
      allow update: if isLeagueAdministrator(resource.data.leagueId)
        && validLeagueMembershipStatusUpdate();
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "registered"
        && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.status == "registration";
    }

    match /leagueContributions/{contributionId} {
      allow read: if isPlatformAdmin()
        || isLeagueMember(resource.data.leagueId)
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn()
        && validLeagueContributionCreate(contributionId);
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !existsAfter(
          /databases/$(database)/documents/challengeEntries/$(resource.data.entryId)
        );
    }

    match /challengeEntries/{entryId} {
      allow create: if signedIn() && validChallengeEntry();
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validAnnouncementCreate(announcementId);
      allow update: if isPlatformAdmin()
        && validAnnouncementUpdate(announcementId);
      allow delete: if false;
    }

    match /exerciseSuggestions/{suggestionId} {
      allow create: if signedIn() && validExerciseSuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && (
          validSuggestionReview("exerciseSuggestions", suggestionId)
          || validSuggestionPublish("exerciseSuggestions", suggestionId)
        );
      allow delete: if false;
    }

    match /librarySuggestions/{suggestionId} {
      allow create: if signedIn() && validLibrarySuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && (
          validSuggestionReview("librarySuggestions", suggestionId)
          || validSuggestionPublish("librarySuggestions", suggestionId)
        );
      allow delete: if false;
    }

    match /publishedLibraryItems/{itemId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validPublishedLibraryItemCreate(itemId);
      allow update: if isPlatformAdmin()
        && validPublishedLibraryItemArchive(itemId);
      allow delete: if false;
    }

    match /libraryReleases/{releaseId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validLibraryReleaseCreate(releaseId);
      allow update, delete: if false;
    }

    match /clientErrorReports/{reportId} {
      allow create: if signedIn() && validClientErrorReportCreate();
      allow read: if isPlatformAdmin();
      allow update: if isPlatformAdmin()
        && validClientErrorReportResolve(reportId);
      allow delete: if false;
    }

    match /auditEvents/{auditId} {
      allow read: if isPlatformAdmin();
      allow create: if canCreateScopedAuditEvent() && validAuditEvent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
