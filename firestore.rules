rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }


    function hasPlatformAdminProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isPlatformAdmin() {
      return hasPlatformAdminProfile();
    }

    function hasLeagueAdminProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "leagueAdmin";
    }

    function isLeagueOperator() {
      return isPlatformAdmin() ? true : hasLeagueAdminProfile();
    }

    function isLeagueMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + request.auth.uid));
    }

    function isLeagueAdministrator(leagueId) {
      return isPlatformAdmin()
        ? true
        : (
          signedIn()
          && exists(/databases/$(database)/documents/leagues/$(leagueId))
          && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.administratorIds
        );
    }

    function canReadEvidenceOperations(leagueId) {
      return isLeagueAdministrator(leagueId);
    }

    function canReadLiveLeagueOperations(leagueId) {
      return isLeagueAdministrator(leagueId);
    }

    function managesLeagueAfter(leagueId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/leagues/$(leagueId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.administratorIds;
    }

    function canCreateScopedAuditEvent() {
      return isPlatformAdmin()
        ? true
        : (
          request.resource.data.entityType == "league"
            ? (
              isLeagueAdministrator(request.resource.data.entityId)
                ? true
                : (
                  managesLeagueAfter(request.resource.data.entityId)
                    ? true
                    : leadsHouseInLeague(request.resource.data.entityId)
                )
            )
            : false
        );
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        "legacy-trophy",
        "phoenix-rise",
        "iron-shield",
        "storm-runner",
        "wild-lion",
        "night-wolf",
        "wisdom-keeper",
        "water-guardian",
        "forge-master",
        "summit-falcon",
        "ember-heart",
        "crowned-champion"
      ];
    }

    function validMbtiType(mbtiType) {
      return mbtiType in [
        "ISTJ", "ISFJ", "INFJ", "INTJ",
        "ISTP", "ISFP", "INFP", "INTP",
        "ESTP", "ESFP", "ENFP", "ENTP",
        "ESTJ", "ESFJ", "ENFJ", "ENTJ"
      ];
    }

    function validRole(role) {
      return role in ["user", "leagueAdmin", "admin"];
    }

    function validAuditAfter(auditId, entityType, entityId) {
      let audit = getAfter(
        /databases/$(database)/documents/auditEvents/$(auditId)
      ).data;

      return audit.actorId == request.auth.uid
        && audit.entityType == entityType
        && audit.entityId == entityId
        && audit.createdAt == request.time;
    }

    function validAuditEvent() {
      return request.resource.data.keys().hasOnly([
          "actorId",
          "action",
          "entityType",
          "entityId",
          "summary",
          "details",
          "createdAt"
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 100
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() >= 2
        && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() >= 1
        && request.resource.data.entityId.size() <= 200
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 4
        && request.resource.data.summary.size() <= 300
        && request.resource.data.details is map
        && request.resource.data.createdAt == request.time;
    }

    function validDraftDeletionAuditAfter(auditId, action, leagueId, houseId) {
      let audit = getAfter(
        /databases/$(database)/documents/auditEvents/$(auditId)
      ).data;
      return audit.actorId == request.auth.uid
        && audit.action == action
        && audit.entityType == "league"
        && audit.entityId == leagueId
        && audit.createdAt == request.time
        && audit.details is map
        && audit.details.get("houseId", "") == houseId;
    }

    function validDraftSeasonDelete(leagueId) {
      let auditId = "draft-season-delete_" + leagueId;
      return isPlatformAdmin()
        && resource.data.mode == "season"
        && resource.data.status == "draft"
        && resource.data.get("participantCount", 0) == 0
        && resource.data.get("chaosStatus", "not-started") == "not-started"
        && resource.data.get("activatedAt", null) == null
        && resource.data.get("completedAt", null) == null
        && resource.data.get("archivedAt", null) == null
        && exists(
          /databases/$(database)/documents/leagueInvites/$(resource.data.inviteCode)
        )
        && !existsAfter(
          /databases/$(database)/documents/leagueInvites/$(resource.data.inviteCode)
        )
        && validDraftDeletionAuditAfter(
          auditId,
          "league.draft-deleted",
          leagueId,
          ""
        );
    }

    function validDraftInviteDelete(code) {
      let leaguePath =
        /databases/$(database)/documents/leagues/$(resource.data.leagueId);
      return isPlatformAdmin()
        && resource.data.status == "closed"
        && exists(leaguePath)
        && get(leaguePath).data.inviteCode == code
        && !existsAfter(leaguePath);
    }

    function validDraftHouseDelete(houseId) {
      let leaguePath =
        /databases/$(database)/documents/leagues/$(resource.data.leagueId);
      let auditId = "draft-house-delete_" + houseId;
      return isPlatformAdmin()
        && exists(leaguePath)
        && resource.data.get("captainId", "") == ""
        && resource.data.get("viceCaptainIds", []).size() == 0
        && resource.data.get("lastElectionId", "") == ""
        && (
          !existsAfter(leaguePath)
          || (
            getAfter(leaguePath).data.mode == "season"
            && getAfter(leaguePath).data.status == "draft"
            && getAfter(leaguePath).data.get("participantCount", 0) == 0
            && getAfter(leaguePath).data.get("chaosStatus", "not-started") == "not-started"
            && getAfter(leaguePath).data.get("activatedAt", null) == null
            && getAfter(leaguePath).data.get("completedAt", null) == null
            && getAfter(leaguePath).data.get("archivedAt", null) == null
            && validDraftDeletionAuditAfter(
              auditId,
              "house.draft-deleted",
              resource.data.leagueId,
              houseId
            )
          )
        );
    }

    function validSeasonBonusReason(reason) {
      return reason is string
        && reason.size() >= 6
        && reason.size() <= 300;
    }

    function validSeasonBonusPositivePoints(points) {
      return points is int && points >= 1 && points <= 10000;
    }

    function validSeasonBonusAdjustmentPoints(points) {
      return points is int && points != 0 && points >= -10000 && points <= 10000;
    }

    function validSeasonBonusAuditAfter(auditId, action, leagueId, referenceId) {
      let audit = getAfter(
        /databases/$(database)/documents/auditEvents/$(auditId)
      ).data;
      return audit.actorId == request.auth.uid
        && audit.action == action
        && audit.entityType == "league"
        && audit.entityId == leagueId
        && audit.createdAt == request.time
        && audit.details is map
        && audit.details.get("referenceId", "") == referenceId;
    }

    function validSeasonBonusRequestCreate(requestId) {
      let data = request.resource.data;
      let league = get(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(data.leagueId + "_" + data.userId)
      ).data;
      return data.keys().hasOnly([
          "leagueId", "userId", "displayName", "points", "reason", "status",
          "requestedBy", "requestedAt", "reviewedBy", "reviewedAt",
          "reviewReason", "awardId", "lastAuditId"
        ])
        && isLeagueAdministrator(data.leagueId)
        && league.mode == "season"
        && league.status == "active"
        && request.time >= league.startDate && request.time <= league.endDate
        && membership.leagueId == data.leagueId
        && membership.userId == data.userId
        && membership.status == "active"
        && membership.currentHouseId != ""
        && data.displayName == membership.displayName
        && validSeasonBonusPositivePoints(data.points)
        && validSeasonBonusReason(data.reason)
        && data.status == "pending"
        && data.requestedBy == request.auth.uid
        && data.requestedAt == request.time
        && data.reviewedBy == ""
        && data.reviewedAt == null
        && data.reviewReason == ""
        && data.awardId == ""
        && data.lastAuditId is string
        && validSeasonBonusAuditAfter(
          data.lastAuditId,
          "season-bonus.requested",
          data.leagueId,
          requestId
        );
    }

    function validSeasonBonusRequestReview(requestId) {
      let data = request.resource.data;
      let approved = data.status == "approved";
      let rejected = data.status == "rejected";
      return isPlatformAdmin()
        && resource.data.status == "pending"
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "reviewedBy", "reviewedAt", "reviewReason", "awardId", "lastAuditId"
        ])
        && (approved || rejected)
        && data.reviewedBy == request.auth.uid
        && data.reviewedAt == request.time
        && data.reviewReason is string
        && data.reviewReason.size() <= 300
        && (approved || data.reviewReason.size() >= 4)
        && data.lastAuditId is string
        && validSeasonBonusAuditAfter(
          data.lastAuditId,
          approved ? "season-bonus.request-approved" : "season-bonus.request-rejected",
          data.leagueId,
          requestId
        )
        && (
          approved
            ? (
              data.awardId is string
              && data.awardId != ""
              && existsAfter(
                /databases/$(database)/documents/seasonBonusAwards/$(data.awardId)
              )
              && getAfter(
                /databases/$(database)/documents/seasonBonusAwards/$(data.awardId)
              ).data.requestId == requestId
              && getAfter(
                /databases/$(database)/documents/seasonBonusAwards/$(data.awardId)
              ).data.userId == data.userId
              && getAfter(
                /databases/$(database)/documents/seasonBonusAwards/$(data.awardId)
              ).data.points == data.points
            )
            : data.awardId == ""
        );
    }

    function validSeasonBonusAwardCommon(awardId) {
      let data = request.resource.data;
      let league = get(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      return isPlatformAdmin()
        && data.keys().hasOnly([
          "leagueId", "userId", "displayName", "avatarId",
          "houseId", "houseName", "houseEmblemId", "points", "reason",
          "kind", "source", "requestId", "requestedBy", "correctsAwardId",
          "contributionId", "rulesVersion", "challengeDate",
          "awardedAt", "awardedBy", "lastAuditId"
        ])
        && league.mode == "season"
        && league.status in ["active", "completed"]
        && data.leagueId is string && data.leagueId.size() > 0
        && data.userId is string && data.userId.size() > 0
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.avatarId is string && data.avatarId.size() > 0 && data.avatarId.size() <= 80
        && data.houseId is string && data.houseId.size() > 0
        && data.houseName is string && data.houseName.size() > 0 && data.houseName.size() <= 80
        && data.houseEmblemId is string && data.houseEmblemId.size() > 0 && data.houseEmblemId.size() <= 80
        && validSeasonBonusReason(data.reason)
        && data.contributionId == "season_bonus_" + awardId
        && data.rulesVersion == league.rulesVersion
        && data.challengeDate is timestamp
        && data.challengeDate >= league.startDate && data.challengeDate <= league.endDate
        && data.awardedAt == request.time
        && data.awardedBy == request.auth.uid
        && data.lastAuditId is string;
    }

    function validCurrentSeasonBonusIdentity(data) {
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(data.leagueId + "_" + data.userId)
      ).data;
      return membership.leagueId == data.leagueId
        && membership.userId == data.userId
        && membership.status == "active"
        && membership.currentHouseId != ""
        && data.displayName == membership.displayName
        && data.avatarId == membership.avatarId
        && data.houseId == membership.currentHouseId
        && data.houseName == membership.currentHouseName
        && data.houseEmblemId == membership.currentHouseEmblemId;
    }

    function validDirectSeasonBonusAward(awardId) {
      let data = request.resource.data;
      let league = get(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      return validSeasonBonusAwardCommon(awardId)
        && league.status == "active"
        && request.time >= league.startDate && request.time <= league.endDate
        && data.challengeDate == request.time
        && validCurrentSeasonBonusIdentity(data)
        && validSeasonBonusPositivePoints(data.points)
        && data.kind == "bonus"
        && data.source == "platform-direct"
        && data.requestId == ""
        && data.requestedBy == ""
        && data.correctsAwardId == ""
        && validSeasonBonusAuditAfter(
          data.lastAuditId,
          "season-bonus.direct-awarded",
          data.leagueId,
          awardId
        );
    }

    function validRequestedSeasonBonusAward(awardId) {
      let data = request.resource.data;
      let league = get(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      let bonusRequest = getAfter(
        /databases/$(database)/documents/seasonBonusRequests/$(data.requestId)
      ).data;
      return validSeasonBonusAwardCommon(awardId)
        && league.status == "active"
        && request.time >= league.startDate && request.time <= league.endDate
        && data.challengeDate == request.time
        && validCurrentSeasonBonusIdentity(data)
        && validSeasonBonusPositivePoints(data.points)
        && data.kind == "bonus"
        && data.source == "league-admin-request"
        && data.requestId != ""
        && data.correctsAwardId == ""
        && bonusRequest.status == "approved"
        && bonusRequest.awardId == awardId
        && bonusRequest.leagueId == data.leagueId
        && bonusRequest.userId == data.userId
        && bonusRequest.points == data.points
        && bonusRequest.reason == data.reason
        && bonusRequest.requestedBy == data.requestedBy
        && bonusRequest.reviewedBy == request.auth.uid
        && bonusRequest.reviewedAt == request.time
        && bonusRequest.lastAuditId == data.lastAuditId
        && validSeasonBonusAuditAfter(
          data.lastAuditId,
          "season-bonus.request-approved",
          data.leagueId,
          data.requestId
        );
    }

    function validCorrectedSeasonBonusAward(awardId) {
      let data = request.resource.data;
      let original = get(
        /databases/$(database)/documents/seasonBonusAwards/$(data.correctsAwardId)
      ).data;
      return validSeasonBonusAwardCommon(awardId)
        && validSeasonBonusAdjustmentPoints(data.points)
        && data.kind == "correction"
        && data.source == "platform-correction"
        && data.requestId == ""
        && data.requestedBy == ""
        && data.correctsAwardId != ""
        && original.leagueId == data.leagueId
        && original.userId == data.userId
        && original.displayName == data.displayName
        && original.avatarId == data.avatarId
        && original.houseId == data.houseId
        && original.houseName == data.houseName
        && original.houseEmblemId == data.houseEmblemId
        && original.rulesVersion == data.rulesVersion
        && original.challengeDate == data.challengeDate
        && validSeasonBonusAuditAfter(
          data.lastAuditId,
          "season-bonus.corrected",
          data.leagueId,
          awardId
        );
    }

    function validSeasonBonusAwardCreate(awardId) {
      return request.resource.data.source == "platform-direct"
        ? validDirectSeasonBonusAward(awardId)
        : request.resource.data.source == "league-admin-request"
          ? validRequestedSeasonBonusAward(awardId)
          : request.resource.data.source == "platform-correction"
            && validCorrectedSeasonBonusAward(awardId);
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "firstName",
          "lastName",
          "fullName",
          "displayName",
          "email",
          "role",
          "team",
          "avatarId",
          "mbtiType",
          "joinedAt",
          "onboardingVersion",
          "onboardingCompletedAt",
          "onboardingUpdatedAt",
          "profileUpdatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.fullName is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.role == "user"
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 80
        && validAvatarId(request.resource.data.avatarId)
        && (
          request.resource.data.get("mbtiType", "") == ""
          || validMbtiType(request.resource.data.get("mbtiType", ""))
        )
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.onboardingVersion == 0
        && request.resource.data.onboardingCompletedAt == null
        && request.resource.data.onboardingUpdatedAt == request.time
        && request.resource.data.profileUpdatedAt == request.time;
    }

    function validOnboardingProfileUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
          "onboardingVersion",
          "onboardingCompletedAt",
          "onboardingUpdatedAt"
        ])
        || (
          request.resource.data.onboardingVersion is int
          && request.resource.data.onboardingVersion in [0, 1]
          && request.resource.data.onboardingUpdatedAt == request.time
          && (
            (
              request.resource.data.onboardingVersion == 0
              && request.resource.data.onboardingCompletedAt == null
            )
            || (
              request.resource.data.onboardingVersion == 1
              && request.resource.data.onboardingCompletedAt == request.time
            )
          )
        );
    }

    function validPlayerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "avatarId",
          "mbtiType",
          "onboardingVersion",
          "onboardingCompletedAt",
          "onboardingUpdatedAt",
          "profileUpdatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && (
          request.resource.data.get("mbtiType", "") == ""
          || validMbtiType(request.resource.data.get("mbtiType", ""))
        )
        && request.resource.data.profileUpdatedAt == request.time
        && validOnboardingProfileUpdate();
    }

    function validAdministratorUserUpdate(userId) {
      return request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "adminUpdatedAt",
          "adminUpdatedBy",
          "lastAuditId"
        ])
        && validRole(request.resource.data.role)
        && request.resource.data.adminUpdatedAt == request.time
        && request.resource.data.adminUpdatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "user",
          userId
        );
    }

    function validLibraryItem() {
      return request.resource.data.itemType is string
        && request.resource.data.usageCount is int
        && request.resource.data.usageCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isRecentChallengeDate(challengeDate) {
      return challengeDate is timestamp
        && challengeDate >= request.time - duration.value(2, "d")
        && challengeDate <= request.time + duration.value(1, "d");
    }

    function validDurationData(data) {
      return data.hours is number
        && data.hours >= 0
        && data.hours <= 24
        && data.minutes is number
        && data.minutes >= 0
        && data.minutes <= 59
        && data.seconds is number
        && data.seconds >= 0
        && data.seconds <= 59
        && data.totalSeconds is number
        && data.totalSeconds > 0
        && data.totalSeconds <= 86400
        && data.totalSeconds == data.hours * 3600 + data.minutes * 60 + data.seconds
        && data.totalMinutes is number
        && data.totalMinutes > 0
        && data.totalMinutes <= 1440
        && data.totalMinutes == data.totalSeconds / 60;
    }

    function validWaterEntryData(data) {
      return data.keys().hasOnly(["amount"])
        && data.amount is number
        && data.amount >= 1
        && data.amount <= 20000;
    }

    function validFruitEntryData(data) {
      return data.keys().hasOnly(["fruitType", "servings"])
        && data.fruitType is string
        && data.fruitType.size() >= 1
        && data.fruitType.size() <= 80
        && data.servings is int
        && data.servings >= 1
        && data.servings <= 100;
    }

    function validReadingEntryData(data) {
      return data.keys().hasOnly([
          "hours",
          "minutes",
          "seconds",
          "totalSeconds",
          "totalMinutes",
          "title",
          "author",
          "totalPages",
          "reflection",
          "completed"
        ])
        && validDurationData(data)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 240
        && data.author is string
        && data.author.size() <= 160
        && (
          data.totalPages == ""
          || (
            data.totalPages is int
            && data.totalPages >= 1
            && data.totalPages <= 100000
          )
        )
        && data.reflection is string
        && data.reflection.size() <= 2000
        && data.completed is bool;
    }

    function validRunningEntryData(data) {
      return data.keys().hasOnly([
          "distance",
          "hours",
          "minutes",
          "seconds",
          "totalSeconds",
          "totalMinutes",
          "averagePaceSecondsPerKm"
        ])
        && validDurationData(data)
        && data.distance is number
        && data.distance > 0
        && data.distance <= 500
        && data.averagePaceSecondsPerKm is number
        && data.averagePaceSecondsPerKm > 0
        && data.averagePaceSecondsPerKm <= 86400;
    }

    function validWorkoutEntryData(data) {
      return data.keys().hasOnly(["exercises"])
        && data.exercises is list
        && data.exercises.size() >= 1
        && data.exercises.size() <= 30;
    }

    function validCardioEntryData(data) {
      return data.keys().hasOnly([
          "activity",
          "source",
          "suggestionStatus",
          "activityDefinition",
          "hours",
          "minutes",
          "seconds",
          "totalSeconds",
          "totalMinutes",
          "distance",
          "notes"
        ])
        && validDurationData(data)
        && data.activity is string
        && data.activity.size() >= 1
        && data.activity.size() <= 120
        && data.source in ["library", "published", "custom"]
        && data.suggestionStatus in ["", "pending"]
        && data.activityDefinition is map
        && (
          data.distance == ""
          || (
            data.distance is number
            && data.distance > 0
            && data.distance <= 1000
          )
        )
        && data.notes is string
        && data.notes.size() <= 1000;
    }

    function validSkillEntryData(data) {
      return data.keys().hasOnly([
          "skill",
          "source",
          "suggestionStatus",
          "skillDefinition",
          "hours",
          "minutes",
          "seconds",
          "totalSeconds",
          "totalMinutes"
        ])
        && validDurationData(data)
        && data.skill is string
        && data.skill.size() >= 1
        && data.skill.size() <= 120
        && data.source in ["library", "published", "custom"]
        && data.suggestionStatus in ["", "pending"]
        && (data.skillDefinition == null || data.skillDefinition is map);
    }

    function validStepsEntryData(data) {
      return data.keys().hasOnly(["steps"])
        && data.steps is int
        && data.steps >= 1
        && data.steps <= 500000;
    }

    function validChallengeEntryData(category, data) {
      return category == "water"
        ? validWaterEntryData(data)
        : (category == "fruit"
          ? validFruitEntryData(data)
          : (category == "reading"
            ? validReadingEntryData(data)
            : (category == "running"
              ? validRunningEntryData(data)
              : (category in ["upperBody", "lowerBody", "core"]
                ? validWorkoutEntryData(data)
                : (category == "cardio"
                  ? validCardioEntryData(data)
                  : (category == "skill"
                    ? validSkillEntryData(data)
                    : (category == "steps"
                      ? validStepsEntryData(data)
                      : false)))))));
    }

    function correctionRootId(entryId, entry) {
      return entry.get("correctionRootEntryId", "") == ""
        ? entryId
        : entry.correctionRootEntryId;
    }

    function validCorrectionChallengeEntry() {
      let source = get(
        /databases/$(database)/documents/challengeEntries/$(request.resource.data.replacesEntryId)
      ).data;
      return isPlatformAdmin()
        && request.resource.data.sourceCorrectionId is string
        && request.resource.data.sourceCorrectionId.size() > 0
        && request.resource.data.userId == source.userId
        && request.resource.data.category == source.category
        && request.resource.data.challengeDate == source.challengeDate
        && source.source != "pocket"
        && request.resource.data.sourceLeagueId == ""
        && request.resource.data.sourcePocketId == ""
        && request.resource.data.sourceRedemptionId == ""
        && request.resource.data.correctionRootEntryId
          == correctionRootId(request.resource.data.replacesEntryId, source)
        && request.resource.data.correctionSequence is int
        && request.resource.data.correctionSequence >= 1;
    }

    function validChallengeEntry(entryId) {
      return request.resource.data.keys().hasOnly([
          "userId", "category", "data", "source", "sourceLeagueId",
          "sourcePocketId", "sourceRedemptionId", "sourceCorrectionId",
          "replacesEntryId", "correctionRootEntryId", "correctionSequence",
          "evidenceClaimIds", "createdAt", "challengeDate"
        ])
        && request.resource.data.category in [
          "water", "fruit", "reading", "running", "upperBody",
          "lowerBody", "core", "cardio", "skill", "steps"
        ]
        && request.resource.data.data is map
        && request.resource.data.get("sourceCorrectionId", "") is string
        && request.resource.data.get("replacesEntryId", "") is string
        && request.resource.data.get("correctionRootEntryId", "") is string
        && request.resource.data.get("correctionSequence", 0) is int
        && request.resource.data.get("evidenceClaimIds", []) is list
        && request.resource.data.get("evidenceClaimIds", []).size() <= 20
        && validChallengeEntryData(request.resource.data.category, request.resource.data.data)
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.source == "activity"
            ? (
              request.resource.data.userId == request.auth.uid
              && request.resource.data.sourceLeagueId == ""
              && request.resource.data.sourcePocketId == ""
              && request.resource.data.sourceRedemptionId == ""
              && request.resource.data.get("sourceCorrectionId", "") == ""
              && request.resource.data.get("replacesEntryId", "") == ""
              && request.resource.data.get("correctionRootEntryId", "") == ""
              && request.resource.data.get("correctionSequence", 0) == 0
              && isRecentChallengeDate(request.resource.data.challengeDate)
            )
            : (
              request.resource.data.source == "pocket"
                ? (
                  request.resource.data.userId == request.auth.uid
                  && request.resource.data.get("sourceCorrectionId", "") == ""
                  && request.resource.data.get("replacesEntryId", "") == ""
                  && request.resource.data.get("correctionRootEntryId", "") == ""
                  && request.resource.data.get("correctionSequence", 0) == 0
                  && validPocketChallengeEntry(entryId)
                )
                : (
                  request.resource.data.source == "correction"
                    ? validCorrectionChallengeEntry()
                    : false
                )
            )
        );
    }

    function validExerciseSuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "exerciseDefinition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.exerciseDefinition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validLibrarySuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "itemType",
          "definition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.itemType in ["cardio", "skill"]
        && request.resource.data.definition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validSuggestionReview(entityType, suggestionId) {
      let data = request.resource.data;
      return resource.data.status == "pending"
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy", "rejectionReason", "lastAuditId"])
        && data.status in ["approved", "rejected"]
        && data.reviewedAt == request.time
        && data.reviewedBy == request.auth.uid
        && data.rejectionReason is string
        && data.rejectionReason.size() <= 500
        && (data.status == "approved" || data.rejectionReason.size() >= 4)
        && validAuditAfter(data.lastAuditId, entityType, suggestionId);
    }

    function validAnnouncementData() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "title", "summary", "body", "type", "icon", "status", "featured",
          "version", "createdAt", "createdBy", "updatedAt", "updatedBy",
          "publishedAt", "lastAuditId"
        ])
        && data.title is string
        && data.summary is string
        && data.body is string
        && data.type in ["release", "feature", "challenge", "community", "maintenance"]
        && data.icon is string
        && data.status in ["draft", "published", "archived"]
        && data.featured is bool
        && data.version is string
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && (data.publishedAt == null || data.publishedAt is timestamp)
        && data.lastAuditId is string;
    }

    function validAnnouncementCreate(announcementId) {
      let data = request.resource.data;
      return validAnnouncementData()
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && (data.status == "published" ? data.publishedAt is timestamp && data.publishedAt <= request.time : data.publishedAt == null)
        && validAuditAfter(data.lastAuditId, "announcement", announcementId);
    }

    function validAnnouncementUpdate(announcementId) {
      let data = request.resource.data;
      return validAnnouncementData()
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && (resource.data.status != "published" && data.status == "published" ? data.publishedAt == request.time : data.publishedAt == resource.data.publishedAt)
        && validAuditAfter(data.lastAuditId, "announcement", announcementId);
    }

    function validAnnouncementRead(announcementId) {
      return request.resource.data.keys().hasOnly([
          "announcementId",
          "readAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.readAt == request.time;
    }


    function validSuggestionPublish(entityType, suggestionId) {
      let data = request.resource.data;
      return resource.data.status == "approved"
        && resource.data.get("publicationStatus", "unpublished") != "published"
        && data.diff(resource.data).affectedKeys().hasOnly(["publicationStatus", "publishedAt", "publishedBy", "publishedLibraryItemId", "libraryVersion", "lastAuditId"])
        && data.publicationStatus == "published"
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.publishedLibraryItemId is string && data.publishedLibraryItemId.size() >= 3
        && data.libraryVersion is string && data.libraryVersion.size() >= 5
        && validAuditAfter(data.lastAuditId, entityType, suggestionId);
    }

    function validPublishedLibraryItemCreate(itemId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "itemType", "name", "normalizedName", "definition", "status", "libraryVersion",
          "sourceSuggestionId", "sourceCollection", "releaseId", "createdAt", "createdBy",
          "updatedAt", "updatedBy", "publishedAt", "archivedAt", "lastAuditId"
        ])
        && data.itemType in ["exercise", "cardio", "skill"]
        && data.name is string && data.normalizedName is string && data.definition is map
        && data.status == "published"
        && data.libraryVersion is string && data.libraryVersion.size() >= 5
        && data.sourceSuggestionId is string && data.sourceSuggestionId.size() >= 1
        && data.sourceCollection in ["exerciseSuggestions", "librarySuggestions"]
        && data.releaseId is string && data.releaseId.size() >= 1
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid
        && data.publishedAt == request.time && data.archivedAt == null
        && validAuditAfter(data.lastAuditId, "publishedLibraryItem", itemId);
    }

    function validPublishedLibraryItemArchive(itemId) {
      let data = request.resource.data;
      return resource.data.status == "published"
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy", "archivedAt", "lastAuditId"])
        && data.status == "archived"
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid
        && data.archivedAt == request.time
        && validAuditAfter(data.lastAuditId, "publishedLibraryItem", itemId);
    }

    function validLibraryReleaseCreate(releaseId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["version", "notes", "status", "itemIds", "itemCount", "createdAt", "createdBy", "publishedAt", "lastAuditId"])
        && data.version is string && data.notes is string
        && data.status == "published"
        && data.itemIds is list && data.itemIds.size() >= 1 && data.itemIds.size() <= 8
        && data.itemCount is int && data.itemCount == data.itemIds.size()
        && data.createdAt == request.time && data.createdBy == request.auth.uid
        && data.publishedAt == request.time
        && validAuditAfter(data.lastAuditId, "libraryRelease", releaseId);
    }

    function validClientErrorReportCreate() {
      return request.resource.data.keys().hasOnly([
          "name",
          "message",
          "stack",
          "source",
          "route",
          "releaseVersion",
          "context",
          "userAgent",
          "occurredAt",
          "fingerprint",
          "userId",
          "status",
          "reportedAt",
          "resolvedAt",
          "resolvedBy",
          "resolutionNote",
          "lastAuditId"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 600
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 4000
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 120
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 300
        && request.resource.data.releaseVersion is string
        && request.resource.data.releaseVersion.size() <= 40
        && request.resource.data.context is map
        && request.resource.data.context.keys().hasOnly(["summary"])
        && request.resource.data.context.summary is string
        && request.resource.data.context.summary.size() <= 1000
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() >= 3
        && request.resource.data.fingerprint.size() <= 500
        && request.resource.data.status == "open"
        && request.resource.data.reportedAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == ""
        && request.resource.data.resolutionNote == ""
        && request.resource.data.lastAuditId == "";
    }

    function validClientErrorReportResolve(reportId) {
      let data = request.resource.data;
      return resource.data.status == "open"
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedAt", "resolvedBy", "resolutionNote", "lastAuditId"])
        && data.status == "resolved"
        && data.resolvedAt == request.time && data.resolvedBy == request.auth.uid
        && data.resolutionNote is string && data.resolutionNote.size() >= 4 && data.resolutionNote.size() <= 500
        && validAuditAfter(data.lastAuditId, "clientErrorReport", reportId);
    }

    function validCoachPreferences() {
      return request.resource.data.keys().hasOnly([
          "enabled",
          "tone",
          "focus",
          "updatedAt"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.tone in ["gentle", "balanced", "direct"]
        && request.resource.data.focus in ["balanced", "consistency", "fitness", "learning"]
        && request.resource.data.updatedAt == request.time;
    }

    function validLeagueModulesV3(modules) {
      return modules.houses == true
        && modules.chaosAssignment == true
        && modules.leadershipElections == true
        && modules.rosterSwaps == true
        && modules.pocketWeek == true
        && modules.powerPlay == true
        && modules.transferMarket == false
        && modules.buddyBonus == false
        && modules.fiveFires == false;
    }

    function validPowerPlayPolicy(policy) {
      return policy is map
        && policy.keys().hasOnly([
          "version", "selectionMode", "durationMode", "activityPointsOnly",
          "evidenceBonusExcluded", "goalAndProgressionBonusesExcluded",
          "multiplierOptions", "noRepeatWithinSeason", "baseCategoryCount",
          "powerPlays", "powerPlayDefinitions"
        ])
        && policy.version == "power-play-v1"
        && policy.selectionMode == "random-without-replacement"
        && policy.durationMode == "season-relative-week"
        && policy.activityPointsOnly == true
        && policy.evidenceBonusExcluded == true
        && policy.goalAndProgressionBonusesExcluded == true
        && policy.multiplierOptions == [2, 3]
        && policy.noRepeatWithinSeason == true
        && policy.baseCategoryCount == 10
        && policy.powerPlays is list
        && policy.powerPlays.size() >= 10
        && policy.powerPlays.size() <= 40
        && policy.powerPlayDefinitions is map
        && policy.powerPlayDefinitions.keys().size() == policy.powerPlays.size();
    }

    // Draft creation uses a compact guard so the three-write season setup batch
    // remains below Firestore's 1,000-expression evaluation limit. The complete
    // policy is still required before registration and on every pool update.
    function validDraftPowerPlayPolicy(policy) {
      return policy is map
        && policy.version == "power-play-v1"
        && policy.powerPlays is list
        && policy.powerPlays.size() >= 10
        && policy.powerPlays.size() <= 40
        && policy.powerPlayDefinitions is map;
    }

    function validInitialPowerPlayState(state) {
      return state is map
        && state.keys().hasOnly([
          "usedPowerPlayIds", "selectionCount", "lastWeekKey",
          "lastPowerPlayId", "lastSelectionAt", "lastSelectionBy"
        ])
        && state.usedPowerPlayIds == []
        && state.selectionCount == 0
        && state.lastWeekKey == ""
        && state.lastPowerPlayId == ""
        && state.lastSelectionAt == null
        && state.lastSelectionBy == "";
    }

    function validDraftPowerPlayState(state) {
      return state is map
        && state.usedPowerPlayIds == []
        && state.selectionCount == 0;
    }

    function validEvidencePolicy(policy) {
      return policy.version == "whatsapp-proof-v1"
        && policy.timezone == "Africa/Johannesburg"
        && policy.proofDeadlineHours is int
        && policy.proofDeadlineHours >= 1
        && policy.proofDeadlineHours <= 168
        && policy.fruitDailyServingCap is int
        && policy.fruitDailyServingCap >= 1
        && policy.fruitDailyServingCap <= 20
        && policy.running.proofRequired == true
        && policy.running.requiredFields == ["activityDate", "distance", "duration"]
        && policy.running.calculatePaceAutomatically == true
        && policy.steps.proofRequired == true
        && policy.steps.requiredFields == [
          "activityDate", "totalSteps", "recognisableAppOrDevice"
        ]
        && policy.waterBonus.enabled == true
        && policy.waterBonus.thresholdMillilitres is int
        && policy.waterBonus.thresholdMillilitres >= 250
        && policy.waterBonus.thresholdMillilitres <= 10000
        && policy.waterBonus.points is int
        && policy.waterBonus.points >= 0
        && policy.waterBonus.points <= 100
        && policy.waterBonus.maximumAwardsPerDay == 1
        && policy.fruitBonus.enabled == true
        && policy.fruitBonus.thresholdServings is int
        && policy.fruitBonus.thresholdServings >= 1
        && policy.fruitBonus.thresholdServings <= 20
        && policy.fruitBonus.points is int
        && policy.fruitBonus.points >= 0
        && policy.fruitBonus.points <= 100
        && policy.fruitBonus.maximumAwardsPerDay == 1
        && policy.leaderboardPublication.timezone == "Africa/Johannesburg"
        && policy.leaderboardPublication.automaticTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && policy.leaderboardPublication.manualPublicationAllowed == true
        && policy.leaderboardPublication.correctedReplacementAllowed == true
        && policy.leaderboardPublication.automaticFallbackMode == "administrator-session";
    }

    function validLeagueRulesetV3V4DraftCreate(ruleset) {
      return ruleset is map
        && ruleset.version in ["season-houses-v3", "season-houses-v4"]
        && ruleset.scoringEngineVersion == "points-v2"
        && ruleset.dailyActivityCap == 20
        && ruleset.dailyParticipationBonus == 5
        && ruleset.includedCategories == [
          "water", "fruit", "reading", "running", "upperBody",
          "lowerBody", "core", "cardio", "skill", "steps"
        ]
        && validLeagueModulesV3(ruleset.modules)
        && validEvidencePolicy(ruleset.evidencePolicy)
        && validDraftPowerPlayPolicy(ruleset.powerPlayPolicy);
    }

    // Full v3/v4 validation is used only on deliberate draft pool maintenance
    // and registration readiness. Draft creation keeps its compact validator.
    function validLeagueRulesetV3V4Full(ruleset) {
      return ruleset is map
        && ruleset.version in ["season-houses-v3", "season-houses-v4"]
        && ruleset.scoringEngineVersion == "points-v2"
        && ruleset.dailyActivityCap == 20
        && ruleset.dailyParticipationBonus == 5
        && ruleset.includedCategories == [
          "water", "fruit", "reading", "running", "upperBody",
          "lowerBody", "core", "cardio", "skill", "steps"
        ]
        && validLeagueModulesV3(ruleset.modules)
        && validEvidencePolicy(ruleset.evidencePolicy)
        && validPowerPlayPolicy(ruleset.powerPlayPolicy);
    }

    function validLeagueTransition(currentStatus, nextStatus) {
      return (currentStatus == "draft" && nextStatus == "registration")
        || (currentStatus == "registration" && nextStatus == "active")
        || (currentStatus == "active" && nextStatus == "completed")
        || (currentStatus == "completed" && nextStatus == "archived");
    }

    function validLeagueCreate(leagueId) {
      return request.resource.data.keys().hasOnly([
          "name", "normalizedName", "description", "theme", "type", "mode",
          "status", "startDate", "endDate", "pocketEnabled",
          "pocketStartDate", "pocketEndDate", "houseCount", "chaosStatus",
          "chaosActivatedAt", "chaosActivatedBy", "rulesVersion", "ruleset",
          "administratorIds", "participantCount", "participantLimit",
          "publishedLeaderboardSnapshotId", "publishedLeaderboardAt",
          "publishedLeaderboardBy", "publishedLeaderboardRevision",
          "powerPlayState", "inviteCode", "createdAt", "createdBy", "updatedAt", "updatedBy",
          "activatedAt", "completedAt", "archivedAt", "lastAuditId"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 4
        && request.resource.data.name.size() <= 70
        && request.resource.data.normalizedName is string
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 400
        && request.resource.data.theme is string
        && request.resource.data.theme.size() >= 3
        && request.resource.data.theme.size() <= 80
        && request.resource.data.type in [
          "Friends", "Family", "Workplace", "School", "Community",
          "Charity", "Tournament"
        ]
        && request.resource.data.mode in ["season", "individual"]
        && request.resource.data.status == "draft"
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate > request.resource.data.startDate
        && request.resource.data.pocketEnabled is bool
        && request.resource.data.pocketStartDate
          == request.resource.data.startDate - duration.value(7, "d")
        && request.resource.data.pocketEndDate
          == request.resource.data.startDate - duration.value(1, "d")
        && request.resource.data.houseCount is int
        && request.resource.data.houseCount >= 2
        && request.resource.data.houseCount <= 8
        && request.resource.data.chaosStatus == "not-started"
        && request.resource.data.chaosActivatedAt == null
        && request.resource.data.chaosActivatedBy == ""
        && request.resource.data.rulesVersion == request.resource.data.ruleset.version
        && validLeagueRulesetV3V4DraftCreate(request.resource.data.ruleset)
        && validDraftPowerPlayState(request.resource.data.powerPlayState)
        && request.resource.data.administratorIds is list
        && request.resource.data.administratorIds.size() == 1
        && request.auth.uid in request.resource.data.administratorIds
        && request.resource.data.participantCount == 0
        && request.resource.data.participantLimit == 160
        && request.resource.data.publishedLeaderboardSnapshotId == ""
        && request.resource.data.publishedLeaderboardAt == null
        && request.resource.data.publishedLeaderboardBy == ""
        && request.resource.data.publishedLeaderboardRevision == 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.activatedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.archivedAt == null
        && request.resource.data.lastAuditId is string
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId)
        && getAfter(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.leagueId == leagueId;
    }

    function validLeagueStatusUpdate(leagueId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt", "updatedBy", "activatedAt",
          "completedAt", "archivedAt", "lastAuditId"
        ])
        && validLeagueTransition(resource.data.status, request.resource.data.status)
        && (
          request.resource.data.status != "registration"
          || !(resource.data.rulesVersion in ["season-houses-v3", "season-houses-v4"])
          || (
            validLeagueRulesetV3V4Full(resource.data.ruleset)
            && validInitialPowerPlayState(resource.data.powerPlayState)
          )
        )
        && (
          request.resource.data.status != "active"
          || resource.data.mode != "season"
          || resource.data.chaosStatus == "activated"
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId)
        && (request.resource.data.status != "active" || request.resource.data.activatedAt == request.time)
        && (request.resource.data.status != "completed" || request.resource.data.completedAt == request.time)
        && (request.resource.data.status != "archived" || request.resource.data.archivedAt == request.time);
    }

    function validLeagueChaosUpdate(leagueId) {
      return resource.data.status == "registration"
        && resource.data.mode == "season"
        && resource.data.participantCount >= resource.data.houseCount * 2
        && resource.data.chaosStatus == "not-started"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "chaosStatus", "chaosActivatedAt", "chaosActivatedBy",
          "updatedAt", "updatedBy", "lastAuditId"
        ])
        && request.resource.data.chaosStatus == "activated"
        && request.resource.data.chaosActivatedAt == request.time
        && request.resource.data.chaosActivatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validLeagueParticipantCountUpdate(leagueId) {
      let memberBefore = exists(
        /databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + request.auth.uid)
      );
      let memberAfter = existsAfter(
        /databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + request.auth.uid)
      );

      return resource.data.status == "registration"
        && request.resource.data.status == "registration"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "participantCount", "participantLimit", "updatedAt", "updatedBy"
        ])
        && request.resource.data.participantCount is int
        && request.resource.data.participantCount >= 0
        && request.resource.data.participantCount <= 160
        && request.resource.data.participantLimit == 160
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (!memberBefore && memberAfter
            && request.resource.data.participantCount == resource.data.get("participantCount", 0) + 1)
          || (memberBefore && !memberAfter
            && request.resource.data.participantCount == resource.data.get("participantCount", 0) - 1)
        );
    }

    function validLeagueUpdate(leagueId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasAny(["participantCount", "participantLimit"])
        ? validLeagueParticipantCountUpdate(leagueId)
        : isLeagueAdministrator(leagueId) && (
          affected.hasAny(["status", "activatedAt", "completedAt", "archivedAt"])
            ? validLeagueStatusUpdate(leagueId)
            : affected.hasAny(["chaosStatus", "chaosActivatedAt", "chaosActivatedBy"])
              ? validLeagueChaosUpdate(leagueId)
              : affected.hasAny(["publishedLeaderboardSnapshotId", "publishedLeaderboardRevision"])
                ? validLeagueLeaderboardUpdate(leagueId)
                : affected.hasAny(["ruleset"])
                  ? validLeaguePowerPlayPoolUpdate(leagueId)
                  : affected.hasAny(["powerPlayState"])
                    ? validPowerPlayStateAdvance(leagueId)
                    : false
        );
    }

    function validLeagueLeaderboardUpdate(leagueId) {
      let snapshot = getAfter(
        /databases/$(database)/documents/leagueLeaderboardSnapshots/$(request.resource.data.publishedLeaderboardSnapshotId)
      ).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "publishedLeaderboardSnapshotId", "publishedLeaderboardAt",
          "publishedLeaderboardBy", "publishedLeaderboardRevision",
          "updatedAt", "updatedBy", "lastAuditId"
        ])
        && request.resource.data.publishedLeaderboardSnapshotId is string
        && request.resource.data.publishedLeaderboardSnapshotId.size() > 0
        && request.resource.data.publishedLeaderboardAt == request.time
        && request.resource.data.publishedLeaderboardBy == request.auth.uid
        && request.resource.data.publishedLeaderboardRevision
          == resource.data.get("publishedLeaderboardRevision", 0) + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "league",
          leagueId
        )
        && snapshot.leagueId == leagueId
        && snapshot.publishedAt == request.time
        && snapshot.publishedBy == request.auth.uid
        && snapshot.lastAuditId == request.resource.data.lastAuditId;
    }

    function validLeaguePowerPlayPoolUpdate(leagueId) {
      return resource.data.status == "draft"
        && resource.data.rulesVersion in ["season-houses-v3", "season-houses-v4"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "ruleset", "updatedAt", "updatedBy", "lastAuditId"
        ])
        && request.resource.data.ruleset.diff(resource.data.ruleset).affectedKeys().hasOnly([
          "powerPlayPolicy"
        ])
        && request.resource.data.ruleset.version == resource.data.rulesVersion
        && validLeagueRulesetV3V4Full(request.resource.data.ruleset)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validPowerPlayStateAdvance(leagueId) {
      let oldState = resource.data.powerPlayState;
      let newState = request.resource.data.powerPlayState;
      let assignment = getAfter(
        /databases/$(database)/documents/leaguePowerPlayWeeks/$(leagueId + "_" + newState.lastWeekKey)
      ).data;
      return resource.data.rulesVersion in ["season-houses-v3", "season-houses-v4"]
        && resource.data.status in ["registration", "active", "completed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "powerPlayState", "updatedAt", "updatedBy", "lastAuditId"
        ])
        && newState.keys().hasOnly([
          "usedPowerPlayIds", "selectionCount", "lastWeekKey",
          "lastPowerPlayId", "lastSelectionAt", "lastSelectionBy"
        ])
        && newState.usedPowerPlayIds is list
        && oldState.usedPowerPlayIds is list
        && newState.usedPowerPlayIds.size() == oldState.usedPowerPlayIds.size() + 1
        && newState.usedPowerPlayIds.hasAll(oldState.usedPowerPlayIds)
        && !(newState.lastPowerPlayId in oldState.usedPowerPlayIds)
        && newState.lastPowerPlayId
          == newState.usedPowerPlayIds[newState.usedPowerPlayIds.size() - 1]
        && newState.selectionCount == oldState.selectionCount + 1
        && newState.lastWeekKey is string
        && newState.lastWeekKey.size() >= 7
        && newState.lastWeekKey.size() <= 12
        && newState.lastPowerPlayId is string
        && newState.lastPowerPlayId.size() >= 4
        && newState.lastPowerPlayId.size() <= 80
        && newState.lastSelectionAt == request.time
        && newState.lastSelectionBy == request.auth.uid
        && assignment.leagueId == leagueId
        && assignment.weekKey == newState.lastWeekKey
        && assignment.powerPlayId == newState.lastPowerPlayId
        && assignment.selectionSequence == newState.selectionCount
        && assignment.lastAuditId == request.resource.data.lastAuditId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validPowerPlayAssignmentShape(leagueId, assignmentId) {
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let definition = league.ruleset.powerPlayPolicy.powerPlayDefinitions[request.resource.data.powerPlayId];
      return request.resource.data.keys().hasOnly([
          "leagueId", "leagueName", "weekKey", "weekIndex", "startDate",
          "endDate", "powerPlayId", "powerPlayName", "multiplier",
          "categories", "selectionSequence", "previousPowerPlayIds",
          "redrawCount", "lastSelectionReason", "selectedAt", "selectedBy",
          "correctedAt", "correctedBy", "correctionReason", "correctionCount",
          "lastAuditId"
        ])
        && assignmentId == leagueId + "_" + request.resource.data.weekKey
        && request.resource.data.leagueId == leagueId
        && request.resource.data.leagueName is string
        && request.resource.data.leagueName.size() >= 4
        && request.resource.data.leagueName.size() <= 70
        && request.resource.data.weekKey is string
        && request.resource.data.weekKey.matches('^week-[0-9][0-9]$')
        && request.resource.data.weekIndex is int
        && request.resource.data.weekIndex >= 1
        && request.resource.data.weekIndex <= 60
        && request.resource.data.startDate is timestamp
        && request.resource.data.endDate is timestamp
        && request.resource.data.startDate >= league.startDate
        && request.resource.data.endDate <= league.endDate
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.endDate <= request.resource.data.startDate + duration.value(6, "d")
        && request.resource.data.powerPlayId is string
        && request.resource.data.powerPlayId.size() >= 4
        && request.resource.data.powerPlayId.size() <= 80
        && request.resource.data.powerPlayName is string
        && request.resource.data.powerPlayName.size() >= 4
        && request.resource.data.powerPlayName.size() <= 80
        && definition is map
        && definition.id == request.resource.data.powerPlayId
        && definition.name == request.resource.data.powerPlayName
        && definition.multiplier == request.resource.data.multiplier
        && definition.categories == request.resource.data.categories
        && definition.enabled == true
        && definition.themeNameConfirmed == true
        && request.resource.data.multiplier in [2, 3]
        && request.resource.data.categories is list
        && request.resource.data.categories.size() >= 1
        && request.resource.data.categories.size() <= 10
        && request.resource.data.categories.hasOnly([
          "water", "fruit", "reading", "running", "upperBody",
          "lowerBody", "core", "cardio", "skill", "steps"
        ])
        && request.resource.data.selectionSequence is int
        && request.resource.data.selectionSequence >= 1
        && request.resource.data.previousPowerPlayIds is list
        && request.resource.data.previousPowerPlayIds.size() <= 40
        && request.resource.data.redrawCount is int
        && request.resource.data.redrawCount >= 0
        && request.resource.data.lastSelectionReason is string
        && request.resource.data.lastSelectionReason.size() <= 500
        && request.resource.data.selectedAt is timestamp
        && request.resource.data.selectedBy is string
        && request.resource.data.correctedBy is string
        && request.resource.data.correctionReason is string
        && request.resource.data.correctionReason.size() <= 500
        && request.resource.data.correctionCount is int
        && request.resource.data.correctionCount >= 0
        && request.resource.data.lastAuditId is string;
    }

    function validPowerPlayAssignmentCreate(assignmentId) {
      let leagueId = request.resource.data.leagueId;
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let leagueAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return isLeagueAdministrator(leagueId)
        && league.rulesVersion in ["season-houses-v3", "season-houses-v4"]
        && league.status in ["registration", "active"]
        && validPowerPlayAssignmentShape(leagueId, assignmentId)
        && request.resource.data.previousPowerPlayIds == []
        && request.resource.data.redrawCount == 0
        && request.resource.data.lastSelectionReason == ""
        && request.resource.data.selectedAt == request.time
        && request.resource.data.selectedBy == request.auth.uid
        && request.resource.data.correctedAt == null
        && request.resource.data.correctedBy == ""
        && request.resource.data.correctionReason == ""
        && request.resource.data.correctionCount == 0
        && request.resource.data.powerPlayId
          == leagueAfter.powerPlayState.lastPowerPlayId
        && request.resource.data.weekKey == leagueAfter.powerPlayState.lastWeekKey
        && request.resource.data.selectionSequence
          == leagueAfter.powerPlayState.selectionCount
        && request.resource.data.lastAuditId == leagueAfter.lastAuditId
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validPowerPlayAssignmentRedraw(assignmentId) {
      let leagueId = resource.data.leagueId;
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let leagueAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return isLeagueAdministrator(leagueId)
        && league.rulesVersion in ["season-houses-v3", "season-houses-v4"]
        && league.status in ["registration", "active"]
        && request.time < resource.data.startDate
        && validPowerPlayAssignmentShape(leagueId, assignmentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "powerPlayId", "powerPlayName", "multiplier", "categories",
          "selectionSequence", "previousPowerPlayIds", "redrawCount",
          "lastSelectionReason", "selectedAt", "selectedBy", "lastAuditId"
        ])
        && request.resource.data.previousPowerPlayIds.size()
          == resource.data.previousPowerPlayIds.size() + 1
        && request.resource.data.previousPowerPlayIds.hasAll(resource.data.previousPowerPlayIds)
        && resource.data.powerPlayId in request.resource.data.previousPowerPlayIds
        && request.resource.data.redrawCount == resource.data.redrawCount + 1
        && request.resource.data.lastSelectionReason.size() >= 8
        && request.resource.data.selectedAt == request.time
        && request.resource.data.selectedBy == request.auth.uid
        && request.resource.data.powerPlayId == leagueAfter.powerPlayState.lastPowerPlayId
        && request.resource.data.weekKey == leagueAfter.powerPlayState.lastWeekKey
        && request.resource.data.selectionSequence == leagueAfter.powerPlayState.selectionCount
        && request.resource.data.lastAuditId == leagueAfter.lastAuditId
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validPowerPlayAssignmentCorrection(assignmentId) {
      let leagueId = resource.data.leagueId;
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let leagueAfter = getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return isPlatformAdmin()
        && league.rulesVersion in ["season-houses-v3", "season-houses-v4"]
        && league.status in ["registration", "active", "completed"]
        && request.time >= resource.data.startDate
        && validPowerPlayAssignmentShape(leagueId, assignmentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "powerPlayId", "powerPlayName", "multiplier", "categories",
          "selectionSequence", "previousPowerPlayIds", "correctedAt",
          "correctedBy", "correctionReason", "correctionCount", "lastAuditId"
        ])
        && request.resource.data.previousPowerPlayIds.size()
          == resource.data.previousPowerPlayIds.size() + 1
        && request.resource.data.previousPowerPlayIds.hasAll(resource.data.previousPowerPlayIds)
        && resource.data.powerPlayId in request.resource.data.previousPowerPlayIds
        && request.resource.data.correctedAt == request.time
        && request.resource.data.correctedBy == request.auth.uid
        && request.resource.data.correctionReason.size() >= 8
        && request.resource.data.correctionCount == resource.data.correctionCount + 1
        && request.resource.data.powerPlayId == leagueAfter.powerPlayState.lastPowerPlayId
        && request.resource.data.weekKey == leagueAfter.powerPlayState.lastWeekKey
        && request.resource.data.selectionSequence == leagueAfter.powerPlayState.selectionCount
        && request.resource.data.lastAuditId == leagueAfter.lastAuditId
        && validAuditAfter(request.resource.data.lastAuditId, "league", leagueId);
    }

    function validLeagueInviteCreate(code) {
      return request.resource.data.keys().hasOnly([
          "leagueId", "leagueName", "status", "createdAt", "createdBy",
          "updatedAt", "updatedBy"
        ])
        && code.size() == 8
        && request.resource.data.leagueId is string
        && request.resource.data.leagueName is string
        && request.resource.data.status == "closed"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && managesLeagueAfter(request.resource.data.leagueId);
    }

    function validLeagueInviteUpdate() {
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt", "updatedBy"
        ])
        && request.resource.data.status in ["active", "closed"]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (leagueAfter.status == "registration" && request.resource.data.status == "active")
          || (leagueAfter.status != "registration" && request.resource.data.status == "closed")
        );
    }

    function validLeagueMembershipCreate(membershipId) {
      let leagueBefore = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      return request.resource.data.keys().hasOnly([
          "leagueId", "userId", "displayName", "avatarId", "role", "status",
          "inviteCode", "currentHouseId", "currentHouseName",
          "currentHouseEmblemId", "currentHouseAccentId", "houseAssignedAt",
          "houseAssignmentMethod", "lastRosterSwapId", "lastRosterWeekKey",
          "rosterLockThroughWeekKey", "rosterEligibleWeekKey",
          "joinedAt", "updatedAt"
        ])
        && membershipId == request.resource.data.leagueId + "_" + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.role == "participant"
        && request.resource.data.status == "registered"
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.currentHouseId == ""
        && request.resource.data.currentHouseName == "Unassigned"
        && request.resource.data.currentHouseEmblemId == ""
        && request.resource.data.currentHouseAccentId == ""
        && request.resource.data.houseAssignedAt == null
        && request.resource.data.houseAssignmentMethod == ""
        && request.resource.data.lastRosterSwapId == ""
        && request.resource.data.lastRosterWeekKey == ""
        && request.resource.data.get("rosterLockThroughWeekKey", "") == ""
        && request.resource.data.get("rosterEligibleWeekKey", "") == ""
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time
        && leagueBefore.status == "registration"
        && leagueAfter.status == "registration"
        && leagueAfter.participantLimit == 160
        && leagueAfter.participantCount == leagueBefore.get("participantCount", 0) + 1
        && leagueAfter.participantCount <= leagueAfter.participantLimit
        && get(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.leagueId == request.resource.data.leagueId
        && get(/databases/$(database)/documents/leagueInvites/$(request.resource.data.inviteCode)).data.status == "active";
    }

    function validLeagueMembershipStatusUpdate() {
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && (
          (leagueAfter.status == "active" && request.resource.data.status == "active")
          || (leagueAfter.status in ["completed", "archived"] && request.resource.data.status == "completed")
        );
    }

    function validMembershipHouseAssignment() {
      let league = getAfter(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;
      let house = getAfter(
        /databases/$(database)/documents/leagueHouses/$(request.resource.data.currentHouseId)
      ).data;
      return isLeagueAdministrator(resource.data.leagueId)
        && league.status == "registration"
        && league.chaosStatus == "activated"
        && resource.data.currentHouseId == ""
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentHouseId", "currentHouseName", "currentHouseEmblemId",
          "currentHouseAccentId", "houseAssignedAt", "houseAssignmentMethod",
          "updatedAt"
        ])
        && house.leagueId == resource.data.leagueId
        && request.resource.data.currentHouseName == house.name
        && request.resource.data.currentHouseEmblemId == house.emblemId
        && request.resource.data.currentHouseAccentId == house.accentId
        && request.resource.data.houseAssignedAt == request.time
        && request.resource.data.houseAssignmentMethod == "chaos"
        && request.resource.data.updatedAt == request.time;
    }

    function currentHouseLeader(houseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagueHouses/$(houseId))
        && (
          get(/databases/$(database)/documents/leagueHouses/$(houseId)).data.captainId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/leagueHouses/$(houseId)).data.viceCaptainIds
        );
    }

    function leadsHouseInLeague(leagueId) {
      let membershipId = leagueId + "_" + request.auth.uid;
      return signedIn()
        && exists(/databases/$(database)/documents/leagueMemberships/$(membershipId))
        && get(/databases/$(database)/documents/leagueMemberships/$(membershipId)).data.currentHouseId != ""
        && currentHouseLeader(
          get(/databases/$(database)/documents/leagueMemberships/$(membershipId)).data.currentHouseId
        );
    }

    function validMembershipRosterSwap() {
      let league = get(
        /databases/$(database)/documents/leagues/$(resource.data.leagueId)
      ).data;
      let swap = getAfter(
        /databases/$(database)/documents/leagueRosterSwaps/$(request.resource.data.lastRosterSwapId)
      ).data;
      let nextHouse = getAfter(
        /databases/$(database)/documents/leagueHouses/$(request.resource.data.currentHouseId)
      ).data;
      let v4 = league.rulesVersion == "season-houses-v4";
      return league.status == "active"
        && swap.actorId == request.auth.uid
        && (isLeagueAdministrator(resource.data.leagueId)
          || currentHouseLeader(swap.firstHouseId)
          || currentHouseLeader(swap.secondHouseId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          v4
            ? [
                "currentHouseId", "currentHouseName", "currentHouseEmblemId",
                "currentHouseAccentId", "houseAssignedAt", "houseAssignmentMethod",
                "lastRosterSwapId", "lastRosterWeekKey", "rosterLockThroughWeekKey",
                "rosterEligibleWeekKey", "updatedAt"
              ]
            : [
                "currentHouseId", "currentHouseName", "currentHouseEmblemId",
                "currentHouseAccentId", "houseAssignedAt", "houseAssignmentMethod",
                "lastRosterSwapId", "lastRosterWeekKey", "updatedAt"
              ]
        )
        && request.resource.data.currentHouseId != resource.data.currentHouseId
        && nextHouse.leagueId == resource.data.leagueId
        && request.resource.data.currentHouseName == nextHouse.name
        && request.resource.data.currentHouseEmblemId == nextHouse.emblemId
        && request.resource.data.currentHouseAccentId == nextHouse.accentId
        && request.resource.data.houseAssignedAt == request.time
        && request.resource.data.houseAssignmentMethod == "weekly-swap"
        && request.resource.data.updatedAt == request.time
        && swap.leagueId == resource.data.leagueId
        && swap.weekKey == request.resource.data.lastRosterWeekKey
        && (
          !v4
          || (
            swap.rulesVersion == "season-houses-v4"
            && request.resource.data.rosterLockThroughWeekKey == swap.lockThroughWeekKey
            && request.resource.data.rosterEligibleWeekKey == swap.eligibleWeekKey
          )
        )
        && (
          (swap.firstPlayerId == resource.data.userId
            && swap.firstHouseId == resource.data.currentHouseId
            && swap.secondHouseId == request.resource.data.currentHouseId)
          || (swap.secondPlayerId == resource.data.userId
            && swap.secondHouseId == resource.data.currentHouseId
            && swap.firstHouseId == request.resource.data.currentHouseId)
        );
    }

    function validHouseCreate() {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      return request.resource.data.keys().hasOnly([
          "leagueId", "name", "description", "motto", "emblemId", "accentId",
          "status", "captainId", "viceCaptainIds", "lastElectionId", "createdAt", "createdBy",
          "updatedAt", "updatedBy", "lastAuditId"
        ])
        && isLeagueAdministrator(request.resource.data.leagueId)
        && league.status == "draft"
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 48
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 220
        && request.resource.data.motto is string
        && request.resource.data.motto.size() >= 3
        && request.resource.data.motto.size() <= 90
        && request.resource.data.emblemId is string
        && request.resource.data.accentId is string
        && request.resource.data.status == "active"
        && request.resource.data.captainId == ""
        && request.resource.data.viceCaptainIds is list
        && request.resource.data.viceCaptainIds.size() == 0
        && request.resource.data.lastElectionId == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(request.resource.data.lastAuditId, "league", request.resource.data.leagueId);
    }

    function validHouseIdentityUpdate() {
      return isLeagueAdministrator(resource.data.leagueId)
        && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.status in ["draft", "registration"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "description", "motto", "emblemId", "accentId",
          "updatedAt", "updatedBy", "lastAuditId"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 48
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 220
        && request.resource.data.motto is string
        && request.resource.data.motto.size() >= 3
        && request.resource.data.motto.size() <= 90
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(request.resource.data.lastAuditId, "league", resource.data.leagueId);
    }

    function validViceCaptainList(leagueId, houseId, captainId, viceIds) {
      return viceIds is list
        && viceIds.size() >= 1
        && viceIds.size() <= 2
        && viceIds.toSet().size() == viceIds.size()
        && !(captainId in viceIds)
        && exists(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + captainId))
        && get(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + captainId)).data.currentHouseId == houseId
        && exists(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + viceIds[0]))
        && get(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + viceIds[0])).data.currentHouseId == houseId
        && (
          viceIds.size() == 1
          || (
            exists(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + viceIds[1]))
            && get(/databases/$(database)/documents/leagueMemberships/$(leagueId + "_" + viceIds[1])).data.currentHouseId == houseId
          )
        );
    }

    function validHouseElectionFinalisation(houseId) {
      let election = getAfter(
        /databases/$(database)/documents/leadershipElections/$(request.resource.data.lastElectionId)
      ).data;
      return isLeagueAdministrator(resource.data.leagueId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "captainId", "viceCaptainIds", "lastElectionId",
          "updatedAt", "updatedBy", "lastAuditId"
        ])
        && election.leagueId == resource.data.leagueId
        && election.houseId == houseId
        && election.status == "finalized"
        && election.finalizedBy == request.auth.uid
        && election.captainId == request.resource.data.captainId
        && election.viceCaptainId == request.resource.data.viceCaptainIds[0]
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "league",
          resource.data.leagueId
        );
    }

    function validCaptainViceAppointment() {
      return request.auth.uid == resource.data.captainId
        && request.resource.data.captainId == resource.data.captainId
        && request.resource.data.lastElectionId == resource.data.lastElectionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "viceCaptainIds", "updatedAt", "updatedBy"
        ])
        && resource.data.viceCaptainIds.size() >= 1
        && request.resource.data.viceCaptainIds[0] == resource.data.viceCaptainIds[0];
    }

    function validHouseLeadershipUpdate(houseId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let captainAppointment = changedKeys.hasOnly([
        "viceCaptainIds", "updatedAt", "updatedBy"
      ]);
      return (
          captainAppointment
            ? validCaptainViceAppointment()
            : validHouseElectionFinalisation(houseId)
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validViceCaptainList(
          resource.data.leagueId,
          houseId,
          request.resource.data.captainId,
          request.resource.data.viceCaptainIds
        );
    }

    function validLeadershipElectionCreate() {
      return get(
          /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
        ).data.status == "active"
        && (isLeagueAdministrator(request.resource.data.leagueId)
          || currentHouseLeader(request.resource.data.houseId))
        && request.resource.data.keys().hasOnly([
          "leagueId", "houseId", "houseName", "weekKey", "status",
          "openedAt", "closesAt", "finalizedAt", "finalizedBy", "captainId",
          "viceCaptainId", "resultStatus", "voteCount", "lastAuditId"
        ])
        && request.resource.data.status == "open"
        && request.resource.data.openedAt is timestamp
        && request.resource.data.openedAt <= request.time
        && request.resource.data.openedAt >= request.time - duration.value(1, "m")
        && request.resource.data.closesAt == request.resource.data.openedAt + duration.value(24, "h")
        && request.resource.data.finalizedAt == null
        && request.resource.data.finalizedBy == ""
        && request.resource.data.captainId == ""
        && request.resource.data.viceCaptainId == ""
        && request.resource.data.resultStatus == "pending"
        && request.resource.data.voteCount == 0
        && get(/databases/$(database)/documents/leagueHouses/$(request.resource.data.houseId)).data.leagueId == request.resource.data.leagueId
        && validAuditAfter(request.resource.data.lastAuditId, "league", request.resource.data.leagueId);
    }

    function validLeadershipElectionFinalize() {
      return isLeagueAdministrator(resource.data.leagueId)
        && resource.data.status == "open"
        && resource.data.closesAt <= request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "finalizedAt", "finalizedBy", "captainId",
          "viceCaptainId", "resultStatus", "voteCount", "lastAuditId"
        ])
        && request.resource.data.status == "finalized"
        && request.resource.data.finalizedAt == request.time
        && request.resource.data.finalizedBy == request.auth.uid
        && request.resource.data.captainId != request.resource.data.viceCaptainId
        && request.resource.data.resultStatus in ["ready", "no-votes", "captain-tie", "vice-tie", "vice-required"]
        && request.resource.data.voteCount is int
        && request.resource.data.voteCount >= 0
        && validAuditAfter(request.resource.data.lastAuditId, "league", resource.data.leagueId);
    }

    function validLeadershipVoteCreate(voteId) {
      let election = get(
        /databases/$(database)/documents/leadershipElections/$(request.resource.data.electionId)
      ).data;
      let voterMembership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      let candidateMembership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.resource.data.candidateId)
      ).data;
      return request.resource.data.keys().hasOnly([
          "electionId", "leagueId", "houseId", "weekKey", "voterId",
          "candidateId", "createdAt"
        ])
        && voteId == request.resource.data.electionId + "_" + request.auth.uid
        && request.resource.data.voterId == request.auth.uid
        && election.status == "open"
        && election.closesAt > request.time
        && election.leagueId == request.resource.data.leagueId
        && election.houseId == request.resource.data.houseId
        && election.weekKey == request.resource.data.weekKey
        && voterMembership.status == "active"
        && candidateMembership.status == "active"
        && voterMembership.currentHouseId == election.houseId
        && candidateMembership.currentHouseId == election.houseId
        && request.resource.data.createdAt == request.time;
    }

    function validCompositionProfileCreate(profileId) {
      let data = request.resource.data;
      let membershipPath = /databases/$(database)/documents/leagueMemberships/$(data.leagueId + "_" + request.auth.uid);
      return profileId == data.leagueId + "_" + request.auth.uid
        && data.keys().hasOnly([
          "leagueId", "userId", "value", "profileVersion", "createdAt", "updatedAt"
        ])
        && data.userId == request.auth.uid
        && data.value in [
          "woman", "man", "non-binary-or-another", "prefer-not-to-say"
        ]
        && data.profileVersion == "season-composition-v1"
        && exists(membershipPath)
        && get(membershipPath).data.status in ["registered", "active"]
        && get(/databases/$(database)/documents/leagues/$(data.leagueId)).data.rulesVersion == "season-houses-v4"
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validCompositionProfileUpdate(profileId) {
      let data = request.resource.data;
      return profileId == resource.data.leagueId + "_" + request.auth.uid
        && resource.data.userId == request.auth.uid
        && data.keys().hasOnly([
          "leagueId", "userId", "value", "profileVersion", "createdAt", "updatedAt"
        ])
        && data.diff(resource.data).affectedKeys().hasOnly([
          "value", "updatedAt"
        ])
        && data.value in [
          "woman", "man", "non-binary-or-another", "prefer-not-to-say"
        ]
        && data.updatedAt == request.time;
    }

    function validBalanceDistribution(distribution, visible) {
      return distribution is map
        && (
          (visible == false && distribution.keys().size() == 0)
          || (
            visible == true
            && distribution.keys().size() == 3
            && distribution.woman is number
            && distribution.woman >= 0
            && distribution.woman <= 100
            && distribution.man is number
            && distribution.man >= 0
            && distribution.man <= 100
            && distribution["non-binary-or-another"] is number
            && distribution["non-binary-or-another"] >= 0
            && distribution["non-binary-or-another"] <= 100
          )
        );
    }

    function validBalanceCounts(counts, disclosedCount) {
      return counts is map
        && counts.keys().size() == 3
        && counts.woman is int
        && counts.woman >= 0
        && counts.man is int
        && counts.man >= 0
        && counts["non-binary-or-another"] is int
        && counts["non-binary-or-another"] >= 0
        && counts.woman + counts.man + counts["non-binary-or-another"] == disclosedCount;
    }

    function validPrivateHouseBalanceWeekCreate(resultId) {
      let data = request.resource.data;
      let league = get(/databases/$(database)/documents/leagues/$(data.leagueId)).data;
      return isLeagueAdministrator(data.leagueId)
        && resultId == data.leagueId + "_" + data.weekKey
        && data.keys().hasOnly([
          "leagueId", "weekKey", "rulesVersion", "calculationVersion", "profileVersion",
          "scoringEnabled", "minimumDisclosureCount", "houseCount", "activeMemberCount",
          "responseCount", "disclosedCount", "undisclosedCount", "preferNotToSayCount",
          "rosterSizeDifference", "averageDeviationPercentagePoints",
          "maximumDeviationPercentagePoints", "balanceStatus", "seasonCompositionCounts",
          "seasonCompositionDistribution", "publicResultId", "createdAt", "createdBy", "lastAuditId"
        ])
        && league.rulesVersion == "season-houses-v4"
        && league.status == "active"
        && data.rulesVersion == "season-houses-v4"
        && data.calculationVersion == "house-balance-v1"
        && data.profileVersion == "season-composition-v1"
        && data.scoringEnabled == false
        && data.minimumDisclosureCount == 3
        && data.houseCount is int
        && data.houseCount >= 2
        && data.houseCount <= 8
        && data.activeMemberCount is int
        && data.activeMemberCount >= 0
        && data.responseCount is int
        && data.responseCount >= 0
        && data.disclosedCount is int
        && data.disclosedCount >= 0
        && data.undisclosedCount == data.activeMemberCount - data.disclosedCount
        && data.preferNotToSayCount is int
        && data.preferNotToSayCount >= 0
        && data.responseCount == data.disclosedCount + data.preferNotToSayCount
        && data.preferNotToSayCount <= data.undisclosedCount
        && data.rosterSizeDifference is int
        && data.rosterSizeDifference >= 0
        && (data.averageDeviationPercentagePoints == null || data.averageDeviationPercentagePoints is number)
        && (data.maximumDeviationPercentagePoints == null || data.maximumDeviationPercentagePoints is number)
        && data.balanceStatus in ["balanced", "review", "attention", "insufficient-data"]
        && validBalanceCounts(data.seasonCompositionCounts, data.disclosedCount)
        && validBalanceDistribution(data.seasonCompositionDistribution, true)
        && data.publicResultId == resultId
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && validAuditAfter(data.lastAuditId, "league", data.leagueId);
    }

    function validPrivateHouseBalanceHouseCreate(rowId) {
      let data = request.resource.data;
      let privateResult = getAfter(
        /databases/$(database)/documents/leagueHouseBalancePrivateWeeks/$(data.resultId)
      ).data;
      return isLeagueAdministrator(data.leagueId)
        && rowId == data.resultId + "_" + data.houseId
        && data.resultId == data.leagueId + "_" + data.weekKey
        && data.keys().hasOnly([
          "leagueId", "weekKey", "resultId", "houseId", "houseName", "houseEmblemId",
          "rosterSize", "responseCount", "disclosedCount", "undisclosedCount",
          "preferNotToSayCount", "compositionCounts", "compositionDistribution",
          "deviationPercentagePoints", "createdAt", "createdBy", "lastAuditId"
        ])
        && data.houseId is string
        && data.houseId.size() > 0
        && data.houseName is string
        && data.houseName.size() >= 2
        && data.houseName.size() <= 80
        && data.houseEmblemId is string
        && data.rosterSize is int
        && data.rosterSize >= 0
        && data.responseCount is int
        && data.responseCount >= 0
        && data.disclosedCount is int
        && data.disclosedCount >= 0
        && data.undisclosedCount == data.rosterSize - data.disclosedCount
        && data.preferNotToSayCount is int
        && data.preferNotToSayCount >= 0
        && data.responseCount == data.disclosedCount + data.preferNotToSayCount
        && data.preferNotToSayCount <= data.undisclosedCount
        && validBalanceCounts(data.compositionCounts, data.disclosedCount)
        && validBalanceDistribution(data.compositionDistribution, true)
        && (
          (data.disclosedCount == 0 && data.deviationPercentagePoints == null)
          || (
            data.disclosedCount > 0
            && data.deviationPercentagePoints is number
            && data.deviationPercentagePoints >= 0
            && data.deviationPercentagePoints <= 100
          )
        )
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && privateResult.publicResultId == data.resultId
        && privateResult.createdAt == request.time
        && privateResult.createdBy == request.auth.uid
        && data.lastAuditId == privateResult.lastAuditId;
    }

    function validPublicHouseBalanceWeekCreate(resultId) {
      let data = request.resource.data;
      let privateResult = getAfter(
        /databases/$(database)/documents/leagueHouseBalancePrivateWeeks/$(resultId)
      ).data;
      let visible = privateResult.disclosedCount >= 3;
      return isLeagueAdministrator(data.leagueId)
        && resultId == data.leagueId + "_" + data.weekKey
        && data == {
          "leagueId": privateResult.leagueId,
          "weekKey": privateResult.weekKey,
          "rulesVersion": "season-houses-v4",
          "calculationVersion": "house-balance-v1",
          "scoringEnabled": false,
          "minimumDisclosureCount": 3,
          "houseCount": privateResult.houseCount,
          "rosterSizeDifference": privateResult.rosterSizeDifference,
          "averageDeviationPercentagePoints": privateResult.averageDeviationPercentagePoints,
          "maximumDeviationPercentagePoints": privateResult.maximumDeviationPercentagePoints,
          "balanceStatus": privateResult.balanceStatus,
          "seasonDistributionVisible": visible,
          "seasonCompositionDistribution": visible ? privateResult.seasonCompositionDistribution : {},
          "privateResultId": resultId,
          "createdAt": request.time
        }
        && validBalanceDistribution(data.seasonCompositionDistribution, visible)
        && privateResult.publicResultId == resultId
        && privateResult.createdAt == request.time
        && privateResult.createdBy == request.auth.uid;
    }

    function validPublicHouseBalanceHouseCreate(rowId) {
      let data = request.resource.data;
      let privateRow = getAfter(
        /databases/$(database)/documents/leagueHouseBalancePrivateHouseWeeks/$(rowId)
      ).data;
      let privateResult = getAfter(
        /databases/$(database)/documents/leagueHouseBalancePrivateWeeks/$(data.resultId)
      ).data;
      let visible = privateResult.disclosedCount >= 3 && privateRow.disclosedCount >= 3;
      return isLeagueAdministrator(data.leagueId)
        && rowId == data.resultId + "_" + data.houseId
        && data.resultId == data.leagueId + "_" + data.weekKey
        && data == {
          "leagueId": privateRow.leagueId,
          "weekKey": privateRow.weekKey,
          "resultId": privateRow.resultId,
          "houseId": privateRow.houseId,
          "houseName": privateRow.houseName,
          "houseEmblemId": privateRow.houseEmblemId,
          "rosterSize": privateRow.rosterSize,
          "compositionVisible": visible,
          "compositionDistribution": visible ? privateRow.compositionDistribution : {},
          "deviationPercentagePoints": visible ? privateRow.deviationPercentagePoints : null,
          "createdAt": request.time
        }
        && validBalanceDistribution(data.compositionDistribution, visible)
        && privateRow.createdAt == request.time
        && privateRow.createdBy == request.auth.uid;
    }

    function validRosterSwapV4MovementPolicy(firstBefore, secondBefore) {
      let firstMovedThisWeek = firstBefore.get("lastRosterWeekKey", "") == request.resource.data.weekKey;
      let secondMovedThisWeek = secondBefore.get("lastRosterWeekKey", "") == request.resource.data.weekKey;
      let firstRestActive = firstBefore.get("rosterLockThroughWeekKey", "") != ""
        && request.resource.data.weekKey <= firstBefore.get("rosterLockThroughWeekKey", "");
      let secondRestActive = secondBefore.get("rosterLockThroughWeekKey", "") != ""
        && request.resource.data.weekKey <= secondBefore.get("rosterLockThroughWeekKey", "");
      let overrideApplied = request.resource.data.get("overrideApplied", false);
      let overrideReason = request.resource.data.get("overrideReason", "");
      let overriddenPlayerIds = request.resource.data.get("overriddenPlayerIds", []);
      return !firstMovedThisWeek
        && !secondMovedThisWeek
        && overriddenPlayerIds is list
        && (
          (
            !firstRestActive
            && !secondRestActive
            && overrideApplied == false
            && overrideReason == ""
            && overriddenPlayerIds.size() == 0
          )
          || (
            (firstRestActive || secondRestActive)
            && overrideApplied == true
            && isPlatformAdmin()
            && overrideReason is string
            && overrideReason.size() >= 12
            && overrideReason.size() <= 500
            && overriddenPlayerIds == (
              firstRestActive
                ? (secondRestActive
                  ? [request.resource.data.firstPlayerId, request.resource.data.secondPlayerId]
                  : [request.resource.data.firstPlayerId])
                : [request.resource.data.secondPlayerId]
            )
          )
        );
    }

    function validRosterSwapCreate(swapId) {
      let firstBefore = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.resource.data.firstPlayerId)
      ).data;
      let secondBefore = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.resource.data.secondPlayerId)
      ).data;
      let firstAfter = getAfter(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.resource.data.firstPlayerId)
      ).data;
      let secondAfter = getAfter(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.resource.data.secondPlayerId)
      ).data;
      let firstHouse = get(
        /databases/$(database)/documents/leagueHouses/$(request.resource.data.firstHouseId)
      ).data;
      let secondHouse = get(
        /databases/$(database)/documents/leagueHouses/$(request.resource.data.secondHouseId)
      ).data;
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let v4 = league.rulesVersion == "season-houses-v4";
      return request.resource.data.keys().hasOnly(
          v4
            ? [
                "leagueId", "weekKey", "firstHouseId", "firstHouseName",
                "secondHouseId", "secondHouseName", "firstPlayerId", "secondPlayerId",
                "actorId", "createdAt", "lastAuditId", "rulesVersion",
                "lockThroughWeekKey", "eligibleWeekKey", "overrideApplied",
                "overrideReason", "overriddenPlayerIds"
              ]
            : [
                "leagueId", "weekKey", "firstHouseId", "firstHouseName",
                "secondHouseId", "secondHouseName", "firstPlayerId", "secondPlayerId",
                "actorId", "createdAt", "lastAuditId"
              ]
        )
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.firstHouseId != request.resource.data.secondHouseId
        && request.resource.data.firstPlayerId != request.resource.data.secondPlayerId
        && request.resource.data.firstPlayerId != firstHouse.captainId
        && !(request.resource.data.firstPlayerId in firstHouse.viceCaptainIds)
        && request.resource.data.secondPlayerId != secondHouse.captainId
        && !(request.resource.data.secondPlayerId in secondHouse.viceCaptainIds)
        && (isLeagueAdministrator(request.resource.data.leagueId)
          || currentHouseLeader(request.resource.data.firstHouseId)
          || currentHouseLeader(request.resource.data.secondHouseId))
        && firstBefore.currentHouseId == request.resource.data.firstHouseId
        && secondBefore.currentHouseId == request.resource.data.secondHouseId
        && firstAfter.currentHouseId == request.resource.data.secondHouseId
        && secondAfter.currentHouseId == request.resource.data.firstHouseId
        && firstAfter.lastRosterSwapId == swapId
        && secondAfter.lastRosterSwapId == swapId
        && (
          !v4
          || (
            request.resource.data.rulesVersion == "season-houses-v4"
            && request.resource.data.weekKey is string
            && request.resource.data.weekKey.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
            && request.resource.data.lockThroughWeekKey is string
            && request.resource.data.lockThroughWeekKey.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
            && request.resource.data.lockThroughWeekKey > request.resource.data.weekKey
            && request.resource.data.eligibleWeekKey is string
            && request.resource.data.eligibleWeekKey.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
            && request.resource.data.eligibleWeekKey > request.resource.data.lockThroughWeekKey
            && firstAfter.rosterLockThroughWeekKey == request.resource.data.lockThroughWeekKey
            && secondAfter.rosterLockThroughWeekKey == request.resource.data.lockThroughWeekKey
            && firstAfter.rosterEligibleWeekKey == request.resource.data.eligibleWeekKey
            && secondAfter.rosterEligibleWeekKey == request.resource.data.eligibleWeekKey
            && validRosterSwapV4MovementPolicy(firstBefore, secondBefore)
            && existsAfter(/databases/$(database)/documents/leagueHouseAssignmentHistory/$(swapId + "_" + request.resource.data.firstPlayerId))
            && existsAfter(/databases/$(database)/documents/leagueHouseAssignmentHistory/$(swapId + "_" + request.resource.data.secondPlayerId))
          )
        )
        && existsAfter(/databases/$(database)/documents/leagueRosterLocks/$(request.resource.data.leagueId + "_" + request.resource.data.firstHouseId + "_" + request.resource.data.weekKey))
        && existsAfter(/databases/$(database)/documents/leagueRosterLocks/$(request.resource.data.leagueId + "_" + request.resource.data.secondHouseId + "_" + request.resource.data.weekKey))
        && request.resource.data.createdAt == request.time
        && validAuditAfter(request.resource.data.lastAuditId, "league", request.resource.data.leagueId);
    }

    function validRosterLockCreate(lockId) {
      let swap = getAfter(
        /databases/$(database)/documents/leagueRosterSwaps/$(request.resource.data.swapId)
      ).data;
      return request.resource.data.keys().hasOnly([
          "leagueId", "houseId", "weekKey", "swapId", "createdAt", "createdBy"
        ])
        && lockId == request.resource.data.leagueId + "_" + request.resource.data.houseId + "_" + request.resource.data.weekKey
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && swap.leagueId == request.resource.data.leagueId
        && swap.weekKey == request.resource.data.weekKey
        && request.resource.data.houseId in [swap.firstHouseId, swap.secondHouseId];
    }

    function validHouseAssignmentHistoryBase(historyId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "leagueId", "userId", "displayName", "weekKey", "fromHouseId",
          "fromHouseName", "toHouseId", "toHouseName", "method", "sourceId",
          "overrideApplied", "overrideReason", "createdAt", "createdBy", "lastAuditId"
        ])
        && historyId == data.sourceId + "_" + data.userId
        && data.leagueId is string
        && data.leagueId.size() > 0
        && data.userId is string
        && data.userId.size() > 0
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.weekKey is string
        && data.fromHouseId is string
        && data.fromHouseName is string
        && data.toHouseId is string
        && data.toHouseId.size() > 0
        && data.toHouseName is string
        && data.toHouseName.size() > 0
        && data.sourceId is string
        && data.sourceId.size() > 0
        && data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && validAuditAfter(
          data.lastAuditId,
          "league",
          data.leagueId
        );
    }

    function validChaosAssignmentHistory() {
      let data = request.resource.data;
      let leagueAfter = getAfter(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      let membershipAfter = getAfter(
        /databases/$(database)/documents/leagueMemberships/$(data.leagueId + "_" + data.userId)
      ).data;
      return data.method == "chaos"
        && isLeagueAdministrator(data.leagueId)
        && data.sourceId == data.leagueId + "_chaos"
        && data.weekKey == ""
        && data.fromHouseId == ""
        && data.fromHouseName == "Unassigned"
        && data.get("overrideApplied", false) == false
        && data.get("overrideReason", "") == ""
        && leagueAfter.rulesVersion == "season-houses-v4"
        && leagueAfter.status == "registration"
        && leagueAfter.chaosStatus == "activated"
        && leagueAfter.chaosActivatedAt == request.time
        && leagueAfter.chaosActivatedBy == request.auth.uid
        && leagueAfter.lastAuditId == data.lastAuditId
        && membershipAfter.userId == data.userId
        && membershipAfter.displayName == data.displayName
        && membershipAfter.currentHouseId == data.toHouseId
        && membershipAfter.currentHouseName == data.toHouseName
        && membershipAfter.houseAssignmentMethod == "chaos"
        && membershipAfter.houseAssignedAt == request.time
        && membershipAfter.updatedAt == request.time;
    }

    function validSwapAssignmentHistory() {
      let data = request.resource.data;
      let swap = getAfter(
        /databases/$(database)/documents/leagueRosterSwaps/$(data.sourceId)
      ).data;
      let userOverridden = data.userId in swap.get("overriddenPlayerIds", []);
      let firstPlayer = data.userId == swap.firstPlayerId;
      return data.method == "weekly-swap"
        && swap.rulesVersion == "season-houses-v4"
        && swap.createdAt == request.time
        && swap.leagueId == data.leagueId
        && swap.actorId == request.auth.uid
        && swap.lastAuditId == data.lastAuditId
        && data.weekKey == swap.weekKey
        && data.userId in [swap.firstPlayerId, swap.secondPlayerId]
        && data.get("overrideApplied", false) == userOverridden
        && data.get("overrideReason", "")
          == (userOverridden ? swap.get("overrideReason", "") : "")
        && data.fromHouseId == (firstPlayer ? swap.firstHouseId : swap.secondHouseId)
        && data.fromHouseName == (firstPlayer ? swap.firstHouseName : swap.secondHouseName)
        && data.toHouseId == (firstPlayer ? swap.secondHouseId : swap.firstHouseId)
        && data.toHouseName == (firstPlayer ? swap.secondHouseName : swap.firstHouseName);
    }

    function validHouseAssignmentHistoryCreate(historyId) {
      return validHouseAssignmentHistoryBase(historyId)
        && (
          validChaosAssignmentHistory()
          || validSwapAssignmentHistory()
        );
    }

    function wholePocketCategory(category) {
      return category in ["running", "upperBody", "core", "lowerBody"];
    }

    function validPocketQuantity(category, value) {
      return value is number
        && value > 0
        && value <= 500000
        && (!wholePocketCategory(category) || value == 1)
        && (!(category in ["water", "fruit", "steps"]) || value is int);
    }

    function pocketEntryMatchesStoredActivity(category, entryData, pocketData, quantity) {
      return (
          wholePocketCategory(category)
          && quantity == 1
          && entryData == pocketData
        )
        || (category == "water" && entryData.amount == quantity)
        || (category == "fruit" && entryData.servings == quantity)
        || (category == "steps" && entryData.steps == quantity)
        || (category == "reading" && entryData.totalMinutes == quantity)
        || (category == "skill" && entryData.totalMinutes == quantity)
        || (
          category == "cardio"
          && entryData.totalMinutes == quantity
          && entryData.activity == pocketData.activity
          && entryData.source == pocketData.source
          && entryData.activityDefinition == pocketData.activityDefinition
        );
    }

    function validPocketActivityCreate() {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      return request.resource.data.keys().hasOnly([
          "leagueId", "userId", "category", "data", "mode", "unit",
          "originalQuantity", "remainingQuantity", "activityDate", "status",
          "lastRedemptionId", "createdAt", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && membership.status == "registered"
        && league.pocketEnabled == true
        && request.time >= league.pocketStartDate
        && request.time < league.startDate
        && request.resource.data.activityDate >= league.pocketStartDate
        && request.resource.data.activityDate <= league.pocketEndDate
        && validChallengeEntryData(request.resource.data.category, request.resource.data.data)
        && request.resource.data.mode == (wholePocketCategory(request.resource.data.category) ? "whole" : "partial")
        && request.resource.data.unit is string
        && validPocketQuantity(request.resource.data.category, request.resource.data.originalQuantity)
        && request.resource.data.remainingQuantity == request.resource.data.originalQuantity
        && request.resource.data.status == "available"
        && request.resource.data.lastRedemptionId == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validPocketActivityRedeem(pocketId) {
      let redemption = getAfter(
        /databases/$(database)/documents/pocketRedemptions/$(request.resource.data.lastRedemptionId)
      ).data;
      return resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "remainingQuantity", "status", "lastRedemptionId", "updatedAt"
        ])
        && request.resource.data.remainingQuantity is number
        && request.resource.data.remainingQuantity >= 0
        && request.resource.data.remainingQuantity < resource.data.remainingQuantity
        && request.resource.data.status == (request.resource.data.remainingQuantity == 0 ? "empty" : "available")
        && request.resource.data.updatedAt == request.time
        && redemption.pocketActivityId == pocketId
        && redemption.userId == request.auth.uid
        && redemption.quantity == resource.data.remainingQuantity - request.resource.data.remainingQuantity;
    }

    function validPocketRedemptionCreate(redemptionId) {
      let pocketBefore = get(
        /databases/$(database)/documents/pocketActivities/$(request.resource.data.pocketActivityId)
      ).data;
      let pocketAfter = getAfter(
        /databases/$(database)/documents/pocketActivities/$(request.resource.data.pocketActivityId)
      ).data;
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      return request.resource.data.keys().hasOnly([
          "leagueId", "userId", "pocketActivityId", "challengeEntryId",
          "category", "quantity", "unit", "targetDate", "houseId", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && league.status == "active"
        && membership.status == "active"
        && membership.currentHouseId == request.resource.data.houseId
        && pocketBefore.userId == request.auth.uid
        && pocketBefore.leagueId == request.resource.data.leagueId
        && pocketBefore.category == request.resource.data.category
        && pocketBefore.unit == request.resource.data.unit
        && validPocketQuantity(request.resource.data.category, request.resource.data.quantity)
        && pocketAfter.lastRedemptionId == redemptionId
        && pocketAfter.remainingQuantity == pocketBefore.remainingQuantity - request.resource.data.quantity
        && request.resource.data.targetDate >= league.startDate
        && request.resource.data.targetDate <= league.endDate
        && request.resource.data.targetDate <= request.time
        && request.resource.data.createdAt == request.time;
    }

    function validPocketChallengeEntry(entryId) {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.sourceLeagueId)
      ).data;
      let redemption = getAfter(
        /databases/$(database)/documents/pocketRedemptions/$(request.resource.data.sourceRedemptionId)
      ).data;
      let pocket = get(
        /databases/$(database)/documents/pocketActivities/$(request.resource.data.sourcePocketId)
      ).data;
      return request.resource.data.source == "pocket"
        && request.resource.data.sourceLeagueId is string
        && request.resource.data.sourcePocketId is string
        && request.resource.data.sourceRedemptionId is string
        && league.status == "active"
        && pocket.userId == request.auth.uid
        && pocket.leagueId == request.resource.data.sourceLeagueId
        && pocket.category == request.resource.data.category
        && redemption.userId == request.auth.uid
        && redemption.challengeEntryId == entryId
        && redemption.pocketActivityId == request.resource.data.sourcePocketId
        && redemption.leagueId == request.resource.data.sourceLeagueId
        && redemption.category == request.resource.data.category
        && redemption.targetDate == request.resource.data.challengeDate
        && pocketEntryMatchesStoredActivity(
          request.resource.data.category,
          request.resource.data.data,
          pocket.data,
          redemption.quantity
        );
    }

    function validEvidenceVerificationCode(category, code) {
      return code is string
        && (
          (category == "running" && code.matches('^RUN-[A-HJ-NP-Z2-9]{6}$'))
          || (category == "steps" && code.matches('^STEP-[A-HJ-NP-Z2-9]{6}$'))
          || (category == "water" && code.matches('^WATER-[A-HJ-NP-Z2-9]{6}$'))
          || (category == "fruit" && code.matches('^FRUIT-[A-HJ-NP-Z2-9]{6}$'))
        );
    }

    function validEvidenceClaimCreate(claimId) {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      let linkedEntryId = request.resource.data.claimType == "required-proof"
        ? request.resource.data.entryId
        : request.resource.data.entryIds[0];
      let entry = getAfter(
        /databases/$(database)/documents/challengeEntries/$(linkedEntryId)
      ).data;
      let policy = league.ruleset.evidencePolicy;
      let requiredClaim = request.resource.data.category in ["running", "steps"];
      let dailyClaim = request.resource.data.category in ["water", "fruit"];
      return request.resource.data.keys().hasOnly([
          "leagueId", "leagueName", "userId", "displayName", "avatarId",
          "houseId", "houseName", "houseEmblemId", "category", "claimType",
          "verificationCode", "dateKey", "challengeDate", "status",
          "pendingPoints", "bonusPointsAvailable", "rulesVersion",
          "releasedPoints", "releasedPointGroup", "reviewedAt", "reviewedBy",
          "reviewReason", "whatsappSubmittedAt", "verifiedQuantity",
          "decisionId", "releasedContributionId", "reversedByDecisionId",
          "supersededByClaimId", "correctionId", "replacesClaimId",
          "correctionIds", "entryId", "entryIds", "deadlineAt",
          "createdAt", "updatedAt"
        ])
        && league.status == "active"
        && league.rulesVersion == "season-houses-v2"
        && policy.version == "whatsapp-proof-v1"
        && membership.userId == request.auth.uid
        && membership.status == "active"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.leagueName == league.name
        && request.resource.data.displayName == membership.displayName
        && request.resource.data.avatarId == membership.avatarId
        && request.resource.data.houseId == membership.currentHouseId
        && request.resource.data.houseName == membership.currentHouseName
        && request.resource.data.houseEmblemId == membership.currentHouseEmblemId
        && request.resource.data.category in ["water", "fruit", "running", "steps"]
        && request.resource.data.category == entry.category
        && claimId in entry.get("evidenceClaimIds", [])
        && entry.userId == request.auth.uid
        && entry.createdAt == request.time
        && request.resource.data.challengeDate == entry.challengeDate
        && request.resource.data.challengeDate >= league.startDate
        && request.resource.data.challengeDate <= league.endDate
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.entryIds is list
        && request.resource.data.entryIds.size() == 1
        && request.resource.data.entryIds[0] == linkedEntryId
        && validEvidenceVerificationCode(
          request.resource.data.category,
          request.resource.data.verificationCode
        )
        && request.resource.data.status == "pending"
        && request.resource.data.pendingPoints is number
        && request.resource.data.pendingPoints >= 0
        && request.resource.data.pendingPoints <= 10000
        && request.resource.data.bonusPointsAvailable is number
        && request.resource.data.bonusPointsAvailable >= 0
        && request.resource.data.bonusPointsAvailable <= 100
        && request.resource.data.rulesVersion == league.rulesVersion
        && request.resource.data.releasedPoints == 0
        && request.resource.data.releasedPointGroup == ""
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == ""
        && request.resource.data.reviewReason == ""
        && request.resource.data.whatsappSubmittedAt == null
        && request.resource.data.verifiedQuantity == 0
        && request.resource.data.decisionId == ""
        && request.resource.data.releasedContributionId == ""
        && request.resource.data.reversedByDecisionId == ""
        && request.resource.data.supersededByClaimId == ""
        && request.resource.data.correctionId == ""
        && request.resource.data.replacesClaimId == ""
        && request.resource.data.correctionIds is list
        && request.resource.data.correctionIds.size() == 0
        && request.resource.data.deadlineAt
          >= request.time + duration.value(policy.proofDeadlineHours * 60 - 5, "m")
        && request.resource.data.deadlineAt
          <= request.time + duration.value(policy.proofDeadlineHours * 60 + 5, "m")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          requiredClaim
            ? (
              request.resource.data.claimType == "required-proof"
              && request.resource.data.entryId == linkedEntryId
              && claimId == request.resource.data.leagueId + "_" + linkedEntryId
              && request.resource.data.pendingPoints > 0
              && request.resource.data.bonusPointsAvailable == 0
            )
            : (
              dailyClaim
                ? (
                  request.resource.data.claimType == "daily-bonus"
                  && request.resource.data.entryId == ""
                  && claimId == request.resource.data.leagueId + "_"
                    + request.auth.uid + "_" + request.resource.data.dateKey
                    + "_" + request.resource.data.category
                  && request.resource.data.pendingPoints == 0
                  && (
                    request.resource.data.category == "water"
                      ? request.resource.data.bonusPointsAvailable == policy.waterBonus.points
                      : request.resource.data.bonusPointsAvailable == policy.fruitBonus.points
                  )
                )
                : false
            )
        );
    }
    function validCorrectionEvidenceClaimCreate(claimId) {
      let data = request.resource.data;
      let correction = getAfter(
        /databases/$(database)/documents/entryCorrections/$(data.correctionId)
      ).data;
      let required = data.claimType == "required-proof";
      return isPlatformAdmin()
        && data.keys().hasOnly([
          "leagueId", "leagueName", "userId", "displayName", "avatarId",
          "houseId", "houseName", "houseEmblemId", "category", "claimType",
          "verificationCode", "dateKey", "challengeDate", "status",
          "pendingPoints", "bonusPointsAvailable", "rulesVersion",
          "releasedPoints", "releasedPointGroup", "reviewedAt", "reviewedBy",
          "reviewReason", "whatsappSubmittedAt", "verifiedQuantity",
          "decisionId", "releasedContributionId", "reversedByDecisionId",
          "supersededByClaimId", "correctionId", "replacesClaimId",
          "correctionIds", "entryId", "entryIds", "deadlineAt",
          "createdAt", "updatedAt"
        ])
        && correction.status == "completed"
        && correction.actorId == request.auth.uid
        && claimId in correction.replacementClaimIds
        && data.userId == correction.userId
        && data.category == correction.category
        && data.challengeDate == correction.challengeDate
        && data.leagueId in correction.affectedLeagueIds
        && data.category in ["water", "fruit", "running", "steps"]
        && data.claimType in ["required-proof", "daily-bonus"]
        && validEvidenceVerificationCode(data.category, data.verificationCode)
        && data.status == "pending"
        && data.pendingPoints is number
        && data.pendingPoints >= 0 && data.pendingPoints <= 10000
        && data.bonusPointsAvailable is number
        && data.bonusPointsAvailable >= 0 && data.bonusPointsAvailable <= 100
        && data.releasedPoints == 0
        && data.decisionId == ""
        && data.releasedContributionId == ""
        && data.reversedByDecisionId == ""
        && data.replacesClaimId is string
        && (data.replacesClaimId == "" || data.replacesClaimId in correction.sourceClaimIds)
        && data.correctionIds == [data.correctionId]
        && data.entryIds == [correction.replacementEntryId]
        && (
          required
            ? data.entryId == correction.replacementEntryId
              && data.pendingPoints > 0
              && data.bonusPointsAvailable == 0
            : data.entryId == ""
              && data.pendingPoints == 0
              && data.bonusPointsAvailable > 0
        )
        && data.deadlineAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }
    function validEvidenceClaimCorrection(claimId) {
      let data = request.resource.data;
      let correctionId = resource.data.claimType == "required-proof"
        ? data.correctionId
        : data.correctionIds[data.correctionIds.size() - 1];
      let correction = getAfter(
        /databases/$(database)/documents/entryCorrections/$(correctionId)
      ).data;
      let priorCorrectionIds = resource.data.get("correctionIds", []);
      let linked = correction.actorId == request.auth.uid
        && correction.userId == resource.data.userId
        && correction.category == resource.data.category
        && data.correctionIds is list
        && data.correctionIds.size() == priorCorrectionIds.size() + 1
        && data.correctionIds.hasAll(priorCorrectionIds)
        && correctionId in data.correctionIds
        && data.updatedAt == request.time;
      return isPlatformAdmin() && linked && (
        resource.data.claimType == "required-proof"
          ? claimId in correction.sourceClaimIds
            && data.diff(resource.data).affectedKeys().hasOnly([
              "status", "reviewedAt", "reviewedBy", "reviewReason",
              "supersededByClaimId", "correctionId", "correctionIds", "updatedAt"
            ])
            && data.status == "superseded"
            && data.reviewedAt == request.time
            && data.reviewedBy == request.auth.uid
            && data.supersededByClaimId is string
            && (data.supersededByClaimId == "" || data.supersededByClaimId in correction.replacementClaimIds)
          : resource.data.claimType == "daily-bonus"
            && claimId in correction.dailyClaimIds
            && data.diff(resource.data).affectedKeys().hasOnly(["entryIds", "correctionIds", "updatedAt"])
            && data.entryIds is list
            && data.entryIds.size() == resource.data.entryIds.size() + 1
            && data.entryIds.hasAll(resource.data.entryIds)
            && correction.replacementEntryId in data.entryIds
      );
    }
    function validEvidenceDecisionCreate(decisionId) {
      let data = request.resource.data;
      let claim = get(
        /databases/$(database)/documents/seasonEvidenceClaims/$(data.claimId)
      ).data;
      let claimAfter = getAfter(
        /databases/$(database)/documents/seasonEvidenceClaims/$(data.claimId)
      ).data;
      let verifies = data.decisionType in ["verify", "late-verify"];
      return isPlatformAdmin()
        && data.keys().hasOnly([
          "claimId", "leagueId", "userId", "entryId", "category",
          "verificationCode", "decisionType", "previousStatus", "nextStatus",
          "pointsDelta", "verifiedQuantity", "whatsappSubmittedAt", "reason",
          "lateException", "actorId", "contributionId", "createdAt"
        ])
        && data.claimId is string
        && data.leagueId == claim.leagueId
        && data.userId == claim.userId
        && data.entryId == claim.entryId
        && data.category == claim.category
        && data.verificationCode == claim.verificationCode
        && data.previousStatus == claim.status
        && data.nextStatus == claimAfter.status
        && data.actorId == request.auth.uid
        && data.reason is string
        && data.reason.size() <= 500
        && data.verifiedQuantity is number
        && data.pointsDelta is number
        && data.pointsDelta >= -10000
        && data.pointsDelta <= 10000
        && data.createdAt == request.time
        && claimAfter.decisionId == decisionId
        && claimAfter.reviewedBy == request.auth.uid
        && claimAfter.reviewedAt == request.time
        && (
          verifies
            ? (
              data.nextStatus == "verified"
              && data.pointsDelta > 0
              && data.contributionId is string
              && data.contributionId.size() > 0
              && data.whatsappSubmittedAt is timestamp
              && data.lateException == (data.decisionType == "late-verify")
              && (
                data.decisionType == "late-verify"
                  ? data.whatsappSubmittedAt > claim.deadlineAt && data.reason.size() >= 6
                  : data.whatsappSubmittedAt <= claim.deadlineAt
              )
            )
            : data.decisionType == "reject"
              ? (
                data.nextStatus == "rejected"
                && data.pointsDelta == 0
                && data.contributionId == ""
                && data.reason.size() >= 4
              )
              : data.decisionType == "reverse"
                && data.nextStatus == "reversed"
                && data.pointsDelta == -1 * claim.releasedPoints
                && data.reason.size() >= 6
                && (
                  claim.releasedPoints > 0
                    ? data.contributionId is string && data.contributionId.size() > 0
                    : data.contributionId == ""
                )
        );
    }
    function validEvidenceClaimUpdate(claimId) {
      let data = request.resource.data;
      let decision = getAfter(
        /databases/$(database)/documents/seasonEvidenceDecisions/$(data.decisionId)
      ).data;
      let validTransition = resource.data.status in ["pending", "reversed"]
        ? data.status in ["verified", "rejected"]
        : resource.data.status in ["verified", "rejected"]
          && data.status == "reversed";
      return isPlatformAdmin()
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status", "reviewedAt", "reviewedBy", "reviewReason",
          "whatsappSubmittedAt", "verifiedQuantity", "decisionId",
          "releasedContributionId", "releasedPoints", "releasedPointGroup",
          "reversedByDecisionId", "updatedAt"
        ])
        && validTransition
        && data.reviewedAt == request.time
        && data.reviewedBy == request.auth.uid
        && data.reviewReason is string
        && data.reviewReason.size() <= 500
        && data.updatedAt == request.time
        && decision.claimId == claimId
        && decision.actorId == request.auth.uid
        && decision.nextStatus == data.status
        && decision.createdAt == request.time
        && (
          data.status == "verified"
            ? (
              data.releasedPoints == decision.pointsDelta
              && data.releasedPoints > 0
              && data.releasedContributionId == decision.contributionId
              && data.releasedPointGroup in ["activity", "evidenceBonus"]
              && data.reversedByDecisionId == ""
            )
            : data.status == "rejected"
              ? (
                data.releasedPoints == 0
                && data.releasedContributionId == ""
                && data.releasedPointGroup == ""
              )
              : data.status == "reversed"
                && data.releasedPoints == 0
                && data.reversedByDecisionId == data.decisionId
        );
    }
    function validEvidenceContributionCreate(contributionId) {
      let data = request.resource.data;
      let claim = getAfter(
        /databases/$(database)/documents/seasonEvidenceClaims/$(data.evidenceClaimId)
      ).data;
      let decision = getAfter(
        /databases/$(database)/documents/seasonEvidenceDecisions/$(data.evidenceDecisionId)
      ).data;
      return isPlatformAdmin()
        && contributionId == decision.contributionId
        && decision.actorId == request.auth.uid
        && decision.claimId == data.evidenceClaimId
        && decision.pointsDelta == data.activityPoints
        && claim.decisionId == data.evidenceDecisionId
        && data.leagueId == claim.leagueId
        && data.userId == claim.userId
        && data.category == claim.category
        && data.pointGroup in ["activity", "evidenceBonus"]
        && data.source in ["evidence-release", "evidence-bonus", "evidence-reversal"]
        && data.get("correctionId", "") == ""
        && data.get("correctionRole", "") == ""
        && data.activityPoints is number
        && data.activityPoints >= -10000 && data.activityPoints <= 10000
        && data.createdAt == request.time;
    }

    function validActivityLeagueContributionCreate(contributionId) {
      let league = get(
        /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
      ).data;
      let membership = get(
        /databases/$(database)/documents/leagueMemberships/$(request.resource.data.leagueId + "_" + request.auth.uid)
      ).data;
      let entry = getAfter(
        /databases/$(database)/documents/challengeEntries/$(request.resource.data.entryId)
      ).data;
      let scoreCategory = request.resource.data.get(
        "scoreCategory",
        request.resource.data.category
      );
      return contributionId
          == request.resource.data.leagueId + "_" + request.resource.data.entryId
        && request.resource.data.userId == request.auth.uid
        && membership.userId == request.auth.uid
        && membership.status == "active"
        && league.status == "active"
        && request.resource.data.rulesVersion == league.rulesVersion
        && request.resource.data.displayName == membership.displayName
        && request.resource.data.avatarId == membership.avatarId
        && request.resource.data.houseId == membership.currentHouseId
        && request.resource.data.houseName == membership.currentHouseName
        && request.resource.data.houseEmblemId == membership.currentHouseEmblemId
        && request.resource.data.teamId == membership.currentHouseId
        && request.resource.data.teamName == membership.currentHouseName
        && entry.userId == request.auth.uid
        && request.resource.data.category == entry.category
        && request.resource.data.category in league.ruleset.includedCategories
        && request.resource.data.challengeDate == entry.challengeDate
        && request.resource.data.challengeDate >= league.startDate
        && request.resource.data.challengeDate <= league.endDate
        && request.resource.data.source == entry.source
        && request.resource.data.sourceRedemptionId == entry.sourceRedemptionId
        && request.resource.data.get("pointGroup", "activity") == "activity"
        && request.resource.data.get("evidenceClaimId", "") == ""
        && request.resource.data.get("evidenceDecisionId", "") == ""
        && request.resource.data.get("correctionId", "") == ""
        && request.resource.data.get("correctionRole", "") == ""
        && request.resource.data.get("replacesContributionIds", []) is list
        && request.resource.data.get("replacesContributionIds", []).size() == 0
        && request.resource.data.activityPoints is number
        && request.resource.data.activityPoints >= 0
        && request.resource.data.activityPoints <= 10000
        && request.resource.data.createdAt == request.time
        && (
          league.rulesVersion == "season-houses-v1"
          || (
            league.rulesVersion == "season-houses-v2"
            && request.resource.data.category != "steps"
            && (
              (request.resource.data.category == "running"
                && scoreCategory == "cardio")
              || (request.resource.data.category != "running"
                && scoreCategory == request.resource.data.category)
            )
            && !(
              entry.source == "pocket"
              && request.resource.data.category in ["running", "steps"]
            )
          )
        );
    }
    function validCorrectionLeagueContributionCreate(contributionId) {
      let data = request.resource.data;
      let correction = getAfter(
        /databases/$(database)/documents/entryCorrections/$(data.correctionId)
      ).data;
      let reversal = data.correctionRole == "reversal";
      return isPlatformAdmin()
        && correction.status == "completed"
        && correction.actorId == request.auth.uid
        && correction.userId == data.userId
        && correction.category == data.category
        && correction.challengeDate == data.challengeDate
        && data.leagueId in correction.affectedLeagueIds
        && data.pointGroup == "activity"
        && data.sourceRedemptionId == ""
        && data.evidenceClaimId == ""
        && data.evidenceDecisionId == ""
        && data.createdAt == request.time
        && data.activityPoints is number
        && data.activityPoints >= -10000
        && data.activityPoints <= 10000
        && data.replacesContributionIds is list
        && (
          reversal
            ? (
              contributionId in correction.reversalContributionIds
              && data.entryId == correction.sourceEntryId
              && data.source == "correction-reversal"
              && data.activityPoints < 0
              && data.replacesContributionIds.size() > 0
              && data.replacesContributionIds.hasOnly(correction.sourceContributionIds)
            )
            : data.correctionRole == "replacement"
              && contributionId in correction.replacementContributionIds
              && data.entryId == correction.replacementEntryId
              && data.source == "correction-replacement"
              && data.activityPoints > 0
              && data.replacesContributionIds.size() == 0
        );
    }

    function validSeasonBonusContributionCreate(contributionId) {
      let data = request.resource.data;
      let award = getAfter(
        /databases/$(database)/documents/seasonBonusAwards/$(data.bonusAwardId)
      ).data;
      return isPlatformAdmin()
        && contributionId == award.contributionId
        && contributionId == "season_bonus_" + data.bonusAwardId
        && award.awardedBy == request.auth.uid
        && award.awardedAt == request.time
        && data.leagueId == award.leagueId
        && data.entryId == ""
        && data.userId == award.userId
        && data.displayName == award.displayName
        && data.avatarId == award.avatarId
        && data.houseId == award.houseId
        && data.houseName == award.houseName
        && data.houseEmblemId == award.houseEmblemId
        && data.teamId == award.houseId
        && data.teamName == award.houseName
        && data.category == "seasonBonus"
        && data.scoreCategory == "seasonBonus"
        && data.pointGroup == "seasonBonus"
        && data.challengeDate == award.challengeDate
        && data.activityPoints == award.points
        && data.rulesVersion == award.rulesVersion
        && data.source == "season-bonus"
        && data.sourceRedemptionId == ""
        && data.evidenceClaimId == ""
        && data.evidenceDecisionId == ""
        && data.correctionId == ""
        && data.correctionRole == ""
        && data.replacesContributionIds is list
        && data.replacesContributionIds.size() == 0
        && data.createdAt == request.time;
    }

    function validLeagueContributionCreate(contributionId) {
      return request.resource.data.keys().hasOnly([
          "leagueId", "entryId", "userId", "displayName", "avatarId",
          "houseId", "houseName", "houseEmblemId", "teamId", "teamName",
          "category", "scoreCategory", "pointGroup", "challengeDate",
          "activityPoints", "rulesVersion", "source", "sourceRedemptionId",
          "evidenceClaimId", "evidenceDecisionId", "correctionId",
          "correctionRole", "replacesContributionIds", "bonusAwardId", "createdAt"
        ])
        && (
          request.resource.data.get("bonusAwardId", "") != ""
            ? validSeasonBonusContributionCreate(contributionId)
            : request.resource.data.get("correctionId", "") != ""
              ? validCorrectionLeagueContributionCreate(contributionId)
              : (
                request.resource.data.get("evidenceDecisionId", "") == ""
                  ? validActivityLeagueContributionCreate(contributionId)
                  : validEvidenceContributionCreate(contributionId)
              )
        );
    }

    function validLeaderboardSnapshotCreate(snapshotId) {
      let data = request.resource.data;
      let league = getAfter(
        /databases/$(database)/documents/leagues/$(data.leagueId)
      ).data;
      return isLeagueAdministrator(data.leagueId)
        && data.keys().hasOnly([
          "leagueId", "rulesVersion", "publicationType", "replacesSnapshotId",
          "publicationDateKey", "players", "houses", "honours",
          "publishedAt", "publishedBy", "lastAuditId"
        ])
        && league.status in ["active", "completed"]
        && data.rulesVersion == league.rulesVersion
        && data.publicationType in ["manual", "automatic-fallback"]
        && data.replacesSnapshotId is string
        && data.publicationDateKey is string
        && data.publicationDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.players is list && data.players.size() <= 160
        && data.houses is list && data.houses.size() <= 8
        && data.honours is map
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && data.lastAuditId is string
        && validAuditAfter(data.lastAuditId, "league", data.leagueId)
        && league.publishedLeaderboardSnapshotId == snapshotId
        && league.publishedLeaderboardAt == request.time
        && league.publishedLeaderboardBy == request.auth.uid;
    }
    function validEvidenceNotificationCreate(notificationId) {
      let data = request.resource.data;
      let claimId = data.get("evidenceClaimId", "");
      let claim = getAfter(
        /databases/$(database)/documents/seasonEvidenceClaims/$(claimId)
      ).data;
      return claimId != ""
        && data.userId == claim.userId
        && data.leagueId == claim.leagueId
        && data.houseId == claim.houseId
        && (
          data.type == "evidence-deadline-missed"
            ? notificationId == "evidence-deadline_" + claimId
              && request.auth.uid == claim.userId
              && claim.status == "pending"
              && request.time > claim.deadlineAt
            : isPlatformAdmin()
              && data.type in [
                "evidence-accepted", "evidence-rejected",
                "evidence-bonus-awarded", "evidence-decision-reversed"
              ]
              && claim.reviewedBy == request.auth.uid
              && claim.reviewedAt == request.time
        );
    }

    function validPlayerNotificationCreate(notificationId) {
      let data = request.resource.data;
      let membership = getAfter(
        /databases/$(database)/documents/leagueMemberships/$(data.leagueId + "_" + data.userId)
      ).data;
      let sameHouse = data.houseId != "" && membership.currentHouseId == data.houseId;
      return data.keys().hasOnly([
          "userId", "type", "title", "message", "leagueId", "houseId",
          "evidenceClaimId", "actionPath", "createdAt", "readAt", "readBy"
        ])
        && data.type in [
          "chaos-assignment", "leadership-vote-open", "leadership-result",
          "roster-swap", "pocket-redeemed", "season-notice",
          "evidence-accepted", "evidence-rejected", "evidence-bonus-awarded",
          "evidence-decision-reversed", "evidence-deadline-missed",
          "power-play-selected", "power-play-corrected"
        ]
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 3 && data.message.size() <= 500
        && data.actionPath is string && data.actionPath.size() <= 200
        && data.get("evidenceClaimId", "") is string
        && data.createdAt == request.time
        && data.readAt == null
        && data.readBy == ""
        && membership.leagueId == data.leagueId
        && (
          data.type == "chaos-assignment"
            ? isLeagueAdministrator(data.leagueId) && sameHouse
            : data.type == "leadership-vote-open"
              ? (isLeagueAdministrator(data.leagueId) || currentHouseLeader(data.houseId)) && sameHouse
              : data.type == "leadership-result"
                ? isLeagueAdministrator(data.leagueId) && sameHouse
                : data.type == "roster-swap"
                  ? (isLeagueAdministrator(data.leagueId) || leadsHouseInLeague(data.leagueId)) && sameHouse
                  : data.type == "pocket-redeemed"
                    ? data.userId == request.auth.uid && sameHouse
                    : data.type in ["season-notice", "power-play-selected", "power-play-corrected"]
                      ? isLeagueAdministrator(data.leagueId)
                      : validEvidenceNotificationCreate(notificationId)
        );
    }

    function validPlayerNotificationRead() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "readAt", "readBy"
        ])
        && request.resource.data.readAt == request.time
        && request.resource.data.readBy == request.auth.uid;
    }

    function validAccountDeletionReason(reasonCode) {
      return reasonCode in [
        "prefer-not-to-say",
        "privacy",
        "not-using",
        "duplicate-account",
        "technical",
        "other"
      ];
    }

    function validRequestedDeletionState(userId) {
      let data = request.resource.data;
      return data.userId == userId
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.status == "requested"
        && validAccountDeletionReason(data.reasonCode)
        && data.acknowledgementVersion == 2
        && data.requestedAt == request.time && data.updatedAt == request.time
        && data.cancelledAt == null
        && data.acknowledgedAt == null && data.acknowledgedBy == ""
        && data.lastAuditId == ""
        && data.deletionPolicyVersion == "trusted-deletion-v1"
        && data.waitingPeriodDays == 7
        && data.processingAt == null && data.processingBy == ""
        && data.completedAt == null && data.completedBy == ""
        && data.executionId == ""
        && data.anonymizedPlayerId == "" && data.anonymizedDisplayName == ""
        && data.failureAt == null && data.failureMessage == "";
    }

    function validAccountDeletionRequestCreate(requestId) {
      return requestId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId", "email", "displayName", "status", "reasonCode",
          "acknowledgementVersion", "requestedAt", "updatedAt", "cancelledAt",
          "acknowledgedAt", "acknowledgedBy", "lastAuditId",
          "deletionPolicyVersion", "waitingPeriodDays", "processingAt",
          "processingBy", "completedAt", "completedBy", "executionId",
          "anonymizedPlayerId", "anonymizedDisplayName", "failureAt", "failureMessage"
        ])
        && validRequestedDeletionState(request.auth.uid);
    }

    function validAccountDeletionRequestCancel() {
      return resource.data.userId == request.auth.uid
        && resource.data.status in ["requested", "acknowledged"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "cancelledAt", "updatedAt"
        ])
        && request.resource.data.status == "cancelled"
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAccountDeletionRequestReopen() {
      return resource.data.userId == request.auth.uid
        && resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "displayName", "status", "reasonCode", "acknowledgementVersion",
          "requestedAt", "updatedAt", "cancelledAt", "acknowledgedAt",
          "acknowledgedBy", "lastAuditId", "deletionPolicyVersion",
          "waitingPeriodDays", "processingAt", "processingBy", "completedAt",
          "completedBy", "executionId", "anonymizedPlayerId",
          "anonymizedDisplayName", "failureAt", "failureMessage"
        ])
        && validRequestedDeletionState(resource.data.userId);
    }

    function validAccountDeletionRequestAcknowledge(requestId) {
      let data = request.resource.data;
      return resource.data.status == "requested"
        && data.diff(resource.data).affectedKeys().hasOnly(["status", "acknowledgedAt", "acknowledgedBy", "updatedAt", "lastAuditId"])
        && data.status == "acknowledged"
        && data.acknowledgedAt == request.time && data.updatedAt == request.time
        && data.acknowledgedBy == request.auth.uid
        && validAuditAfter(data.lastAuditId, "accountDeletionRequest", requestId);
    }

    function validEntryCorrectionHeadBase(rootEntryId) {
      let correction = getAfter(
        /databases/$(database)/documents/entryCorrections/$(request.resource.data.lastCorrectionId)
      ).data;
      return isPlatformAdmin()
        && request.resource.data.keys().hasOnly([
          "rootEntryId", "currentEntryId", "userId", "category", "sequence",
          "status", "lastCorrectionId", "lastAuditId", "createdAt",
          "createdBy", "updatedAt", "updatedBy"
        ])
        && request.resource.data.rootEntryId == rootEntryId
        && request.resource.data.currentEntryId == correction.replacementEntryId
        && request.resource.data.userId == correction.userId
        && request.resource.data.category == correction.category
        && request.resource.data.sequence == correction.sequence
        && request.resource.data.status == "active"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastAuditId == correction.lastAuditId
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "entryCorrection",
          request.resource.data.lastCorrectionId
        );
    }

    function validEntryCorrectionHeadCreate(rootEntryId) {
      return validEntryCorrectionHeadBase(rootEntryId)
        && request.resource.data.sequence == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validEntryCorrectionHeadUpdate(rootEntryId) {
      return validEntryCorrectionHeadBase(rootEntryId)
        && request.resource.data.rootEntryId == resource.data.rootEntryId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.sequence == resource.data.sequence + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentEntryId", "sequence", "status", "lastCorrectionId",
          "lastAuditId", "updatedAt", "updatedBy"
        ]);
    }
    function validEntryCorrectionCreate(correctionId) {
      let data = request.resource.data;
      let source = get(
        /databases/$(database)/documents/challengeEntries/$(data.sourceEntryId)
      ).data;
      let replacement = getAfter(
        /databases/$(database)/documents/challengeEntries/$(data.replacementEntryId)
      ).data;
      let headBeforeExists = exists(
        /databases/$(database)/documents/entryCorrectionHeads/$(data.rootEntryId)
      );
      let headBefore = get(
        /databases/$(database)/documents/entryCorrectionHeads/$(data.rootEntryId)
      ).data;
      return isPlatformAdmin()
        && data.keys().hasOnly([
          "rootEntryId", "sourceEntryId", "replacementEntryId", "userId",
          "category", "challengeDate", "sequence", "reason", "actorId",
          "sourcePoints", "replacementPoints", "pointDelta",
          "affectedLeagueIds", "sourceContributionIds",
          "reversalContributionIds", "replacementContributionIds",
          "sourceClaimIds", "replacementClaimIds", "dailyClaimIds",
          "status", "lastAuditId", "createdAt"
        ])
        && data.actorId == request.auth.uid
        && data.status == "completed"
        && data.reason is string
        && data.reason.size() >= 8
        && data.reason.size() <= 500
        && data.sequence is int
        && data.sequence >= 1
        && data.sourcePoints is number
        && data.replacementPoints is number
        && data.pointDelta is number
        && data.affectedLeagueIds is list
        && data.affectedLeagueIds.size() <= 20
        && data.sourceContributionIds is list
        && data.sourceContributionIds.size() <= 100
        && data.reversalContributionIds is list
        && data.reversalContributionIds.size() <= 100
        && data.replacementContributionIds is list
        && data.replacementContributionIds.size() <= 20
        && data.sourceClaimIds is list
        && data.sourceClaimIds.size() <= 20
        && data.replacementClaimIds is list
        && data.replacementClaimIds.size() <= 20
        && data.dailyClaimIds is list
        && data.dailyClaimIds.size() <= 20
        && data.rootEntryId == correctionRootId(data.sourceEntryId, source)
        && (
          data.sequence == 1
            ? !headBeforeExists && data.sourceEntryId == data.rootEntryId
            : headBeforeExists
              && headBefore.currentEntryId == data.sourceEntryId
              && data.sequence == headBefore.sequence + 1
        )
        && source.userId == data.userId
        && source.category == data.category
        && source.challengeDate == data.challengeDate
        && source.source != "pocket"
        && replacement.userId == data.userId
        && replacement.category == data.category
        && replacement.challengeDate == data.challengeDate
        && replacement.source == "correction"
        && replacement.sourceCorrectionId == correctionId
        && replacement.replacesEntryId == data.sourceEntryId
        && replacement.correctionRootEntryId == data.rootEntryId
        && replacement.correctionSequence == data.sequence
        && data.createdAt == request.time
        && validAuditAfter(data.lastAuditId, "entryCorrection", correctionId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validUserProfile(userId);
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow update: if (
        isOwner(userId) && validPlayerProfileUpdate()
      ) || (
        isPlatformAdmin() && validAdministratorUserUpdate(userId)
      );
      allow delete: if false;
    }

    match /users/{userId}/library/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validLibraryItem();
      allow update: if isOwner(userId)
        && validLibraryItem()
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /users/{userId}/announcementReads/{announcementId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validAnnouncementRead(announcementId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/coach/{documentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && documentId == "preferences"
        && validCoachPreferences();
      allow delete: if false;
    }

    match /accountDeletionRequests/{requestId} {
      allow get: if isPlatformAdmin()
        || (signedIn() && requestId == request.auth.uid);
      allow list: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validAccountDeletionRequestCreate(requestId);
      allow update: if signedIn()
        && (
          validAccountDeletionRequestCancel()
          || validAccountDeletionRequestReopen()
          || (
            isPlatformAdmin()
            && validAccountDeletionRequestAcknowledge(requestId)
          )
        );
      allow delete: if false;
    }

    match /accountDeletionExecutions/{executionId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /accountDeletionReceipts/{receiptId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Permanent global teams were retired in v0.14.0.
    // Houses now exist only inside a specific season.
    match /teams/{document=**} {
      allow read, write: if false;
    }

    match /playerTeams/{document=**} {
      allow read, write: if false;
    }

    match /teamInvites/{document=**} {
      allow read, write: if false;
    }

    match /leagues/{leagueId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(leagueId)
        || (
          signedIn()
          && resource.data.status in ["registration", "active", "completed", "archived"]
        );
      allow create: if isLeagueOperator() && validLeagueCreate(leagueId);
      allow update: if signedIn() && validLeagueUpdate(leagueId);
      allow delete: if signedIn() && validDraftSeasonDelete(leagueId);
    }

    match /leagueInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isLeagueOperator() && validLeagueInviteCreate(code);
      allow update: if isLeagueAdministrator(resource.data.leagueId)
        && validLeagueInviteUpdate();
      allow delete: if signedIn() && validDraftInviteDelete(code);
    }

    match /leagueMemberships/{membershipId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isLeagueMember(resource.data.leagueId)
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validLeagueMembershipCreate(membershipId);
      allow update: if signedIn()
        && (
          (
            isLeagueAdministrator(resource.data.leagueId)
            && (
              validLeagueMembershipStatusUpdate()
              || validMembershipHouseAssignment()
            )
          )
          || validMembershipRosterSwap()
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "registered"
        && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.status == "registration"
        && getAfter(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.participantCount
          == get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.get("participantCount", 0) - 1
        && getAfter(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.participantLimit == 160;
    }

    match /leagueHouses/{houseId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validHouseCreate();
      allow update: if signedIn()
        && (
          validHouseIdentityUpdate()
          || validHouseLeadershipUpdate(houseId)
        );
      allow delete: if signedIn() && validDraftHouseDelete(houseId);
    }

    match /leadershipElections/{electionId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validLeadershipElectionCreate();
      allow update: if signedIn() && validLeadershipElectionFinalize();
      allow delete: if false;
    }

    match /leadershipVotes/{voteId} {
      allow get: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || (signedIn() && resource.data.voterId == request.auth.uid);
      allow list: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || (signedIn() && resource.data.voterId == request.auth.uid);
      allow create: if signedIn() && validLeadershipVoteCreate(voteId);
      allow update, delete: if false;
    }

    match /leagueRosterSwaps/{swapId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validRosterSwapCreate(swapId);
      allow update, delete: if false;
    }

    match /leagueRosterLocks/{lockId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validRosterLockCreate(lockId);
      allow update, delete: if false;
    }

    match /leagueHouseAssignmentHistory/{historyId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validHouseAssignmentHistoryCreate(historyId);
      allow update, delete: if false;
    }

    match /leagueCompositionProfiles/{profileId} {
      allow get: if signedIn()
        && (resource.data.userId == request.auth.uid || isLeagueAdministrator(resource.data.leagueId));
      allow list: if signedIn() && isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validCompositionProfileCreate(profileId);
      allow update: if signedIn() && validCompositionProfileUpdate(profileId);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }


    match /leagueHouseBalancePrivateWeeks/{resultId} {
      allow read: if signedIn() && isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validPrivateHouseBalanceWeekCreate(resultId);
      allow update, delete: if false;
    }

    match /leagueHouseBalancePrivateHouseWeeks/{rowId} {
      allow read: if signedIn() && isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validPrivateHouseBalanceHouseCreate(rowId);
      allow update, delete: if false;
    }

    match /leagueHouseBalanceWeeks/{resultId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validPublicHouseBalanceWeekCreate(resultId);
      allow update, delete: if false;
    }

    match /leagueHouseBalanceHouseWeeks/{rowId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || isLeagueMember(resource.data.leagueId);
      allow create: if signedIn() && validPublicHouseBalanceHouseCreate(rowId);
      allow update, delete: if false;
    }

    match /pocketActivities/{pocketId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validPocketActivityCreate();
      allow update: if signedIn() && validPocketActivityRedeem(pocketId);
      allow delete: if false;
    }

    match /pocketRedemptions/{redemptionId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validPocketRedemptionCreate(redemptionId);
      allow update, delete: if false;
    }

    match /entryCorrectionHeads/{rootEntryId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isPlatformAdmin()
        && validEntryCorrectionHeadCreate(rootEntryId);
      allow update: if isPlatformAdmin()
        && validEntryCorrectionHeadUpdate(rootEntryId);
      allow delete: if false;
    }

    match /entryCorrections/{correctionId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isPlatformAdmin()
        && validEntryCorrectionCreate(correctionId);
      allow update, delete: if false;
    }

    match /leagueEvidenceReviewers/{assignmentId} {
      // Retired in v0.24 Checkpoint 8G. Historical documents remain server-managed only.
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /seasonEvidenceClaims/{claimId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || canReadEvidenceOperations(resource.data.leagueId);
      allow create: if signedIn() && (
        validEvidenceClaimCreate(claimId)
        || validCorrectionEvidenceClaimCreate(claimId)
      );
      allow update: if signedIn() && (
        validEvidenceClaimUpdate(claimId)
        || validEvidenceClaimCorrection(claimId)
      );
      allow delete: if false;
    }

    match /seasonEvidenceDecisions/{decisionId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || canReadEvidenceOperations(resource.data.leagueId);
      allow create: if signedIn() && validEvidenceDecisionCreate(decisionId);
      allow update, delete: if false;
    }

    match /leaguePowerPlayWeeks/{assignmentId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId)
        || (
          isLeagueMember(resource.data.leagueId)
          && resource.data.startDate <= request.time
        );
      allow create: if signedIn()
        && validPowerPlayAssignmentCreate(assignmentId);
      allow update: if signedIn() && (
        request.time < resource.data.startDate
          ? validPowerPlayAssignmentRedraw(assignmentId)
          : validPowerPlayAssignmentCorrection(assignmentId)
      );
      allow delete: if false;
    }

    match /leagueLeaderboardSnapshots/{snapshotId} {
      allow read: if isPlatformAdmin()
        || isLeagueMember(resource.data.leagueId)
        || canReadLiveLeagueOperations(resource.data.leagueId);
      allow create: if signedIn() && validLeaderboardSnapshotCreate(snapshotId);
      allow update, delete: if false;
    }

    match /seasonTrustedRuns/{runId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId);
      allow create, update, delete: if false;
    }

    match /playerNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validPlayerNotificationCreate(notificationId);
      allow update: if signedIn() && validPlayerNotificationRead();
      allow delete: if false;
    }

    match /seasonBonusRequests/{requestId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validSeasonBonusRequestCreate(requestId);
      allow update: if signedIn() && validSeasonBonusRequestReview(requestId);
      allow delete: if false;
    }

    match /seasonBonusAwards/{awardId} {
      allow read: if isPlatformAdmin()
        || isLeagueAdministrator(resource.data.leagueId);
      allow create: if signedIn() && validSeasonBonusAwardCreate(awardId);
      allow update, delete: if false;
    }

    match /leagueContributions/{contributionId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || canReadLiveLeagueOperations(resource.data.leagueId)
        || (
          isLeagueMember(resource.data.leagueId)
          && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.rulesVersion
            == "season-houses-v1"
        );
      allow create: if signedIn()
        && validLeagueContributionCreate(contributionId);
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.get("source", "activity") == "activity"
        && get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.status == "active"
        && !existsAfter(
          /databases/$(database)/documents/challengeEntries/$(resource.data.entryId)
        );
    }

    match /challengeEntries/{entryId} {
      allow create: if signedIn() && validChallengeEntry(entryId);
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.get("source", "activity") == "activity"
        && resource.data.get("evidenceClaimIds", []).size() == 0
        && !exists(
          /databases/$(database)/documents/entryCorrectionHeads/$(correctionRootId(entryId, resource.data))
        )
        && isRecentChallengeDate(resource.data.challengeDate);
      allow update: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validAnnouncementCreate(announcementId);
      allow update: if isPlatformAdmin()
        && validAnnouncementUpdate(announcementId);
      allow delete: if false;
    }

    match /exerciseSuggestions/{suggestionId} {
      allow create: if signedIn() && validExerciseSuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && (
          validSuggestionReview("exerciseSuggestions", suggestionId)
          || validSuggestionPublish("exerciseSuggestions", suggestionId)
        );
      allow delete: if false;
    }

    match /librarySuggestions/{suggestionId} {
      allow create: if signedIn() && validLibrarySuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && (
          validSuggestionReview("librarySuggestions", suggestionId)
          || validSuggestionPublish("librarySuggestions", suggestionId)
        );
      allow delete: if false;
    }

    match /publishedLibraryItems/{itemId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validPublishedLibraryItemCreate(itemId);
      allow update: if isPlatformAdmin()
        && validPublishedLibraryItemArchive(itemId);
      allow delete: if false;
    }

    match /libraryReleases/{releaseId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validLibraryReleaseCreate(releaseId);
      allow update, delete: if false;
    }

    match /clientErrorReports/{reportId} {
      allow create: if signedIn() && validClientErrorReportCreate();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isPlatformAdmin()
        && validClientErrorReportResolve(reportId);
      allow delete: if false;
    }

    match /auditEvents/{auditId} {
      allow read: if isPlatformAdmin();
      allow create: if canCreateScopedAuditEvent() && validAuditEvent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
