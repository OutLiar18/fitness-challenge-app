rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "firstName",
          "lastName",
          "fullName",
          "displayName",
          "email",
          "role",
          "team",
          "joinedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.fullName is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.role == "user"
        && request.resource.data.team is string
        && request.resource.data.joinedAt is timestamp;
    }

    function validLibraryItem() {
      return request.resource.data.itemType is string
        && request.resource.data.usageCount is int
        && request.resource.data.usageCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validChallengeEntry() {
      return request.resource.data.keys().hasOnly([
          "userId",
          "category",
          "data",
          "createdAt",
          "challengeDate"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category in [
          "water",
          "fruit",
          "reading",
          "running",
          "upperBody",
          "lowerBody",
          "core",
          "cardio",
          "skill",
          "steps"
        ]
        && request.resource.data.data is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.challengeDate is timestamp;
    }

    function validExerciseSuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "exerciseDefinition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.exerciseDefinition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validLibrarySuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "itemType",
          "definition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.itemType in ["cardio", "skill"]
        && request.resource.data.definition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validUserProfile(userId);
      allow read: if isOwner(userId);

      // Profile editing and account deletion require a designed workflow.
      allow update, delete: if false;
    }

    match /users/{userId}/library/{itemId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validLibraryItem();

      allow update: if isOwner(userId)
        && validLibraryItem()
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /challengeEntries/{entryId} {
      allow create: if signedIn() && validChallengeEntry();

      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      // Saved activity records are immutable.
      allow update: if false;
    }

    match /exerciseSuggestions/{suggestionId} {
      allow create: if signedIn() && validExerciseSuggestion();

      allow read: if signedIn()
        && resource.data.submittedBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /librarySuggestions/{suggestionId} {
      allow create: if signedIn() && validLibrarySuggestion();

      allow read: if signedIn()
        && resource.data.submittedBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}