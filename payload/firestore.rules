rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasPlatformAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasPlatformAdminProfile() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isPlatformAdmin() {
      return hasPlatformAdminClaim() || hasPlatformAdminProfile();
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        "legacy-trophy",
        "phoenix-rise",
        "iron-shield",
        "storm-runner",
        "wild-lion",
        "night-wolf",
        "wisdom-keeper",
        "water-guardian",
        "forge-master",
        "summit-falcon",
        "ember-heart",
        "crowned-champion"
      ];
    }

    function validRole(role) {
      return role in ["user", "leagueAdmin", "admin"];
    }

    function validAuditAfter(auditId, entityType, entityId) {
      let audit = getAfter(
        /databases/$(database)/documents/auditEvents/$(auditId)
      ).data;

      return audit.actorId == request.auth.uid
        && audit.entityType == entityType
        && audit.entityId == entityId
        && audit.createdAt == request.time;
    }

    function validAuditEvent() {
      return request.resource.data.keys().hasOnly([
          "actorId",
          "action",
          "entityType",
          "entityId",
          "summary",
          "details",
          "createdAt"
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 100
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() >= 2
        && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() >= 1
        && request.resource.data.entityId.size() <= 200
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 4
        && request.resource.data.summary.size() <= 300
        && request.resource.data.details is map
        && request.resource.data.createdAt == request.time;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "firstName",
          "lastName",
          "fullName",
          "displayName",
          "email",
          "role",
          "team",
          "avatarId",
          "joinedAt",
          "profileUpdatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.fullName is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.role == "user"
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 80
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.profileUpdatedAt is timestamp;
    }

    function validPlayerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "avatarId",
          "profileUpdatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validAvatarId(request.resource.data.avatarId)
        && request.resource.data.profileUpdatedAt == request.time;
    }

    function validAdministratorUserUpdate(userId) {
      return request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "team",
          "adminUpdatedAt",
          "adminUpdatedBy",
          "lastAuditId"
        ])
        && validRole(request.resource.data.role)
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 80
        && request.resource.data.adminUpdatedAt == request.time
        && request.resource.data.adminUpdatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "user",
          userId
        );
    }

    function validLibraryItem() {
      return request.resource.data.itemType is string
        && request.resource.data.usageCount is int
        && request.resource.data.usageCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validChallengeEntry() {
      return request.resource.data.keys().hasOnly([
          "userId",
          "category",
          "data",
          "createdAt",
          "challengeDate"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category in [
          "water",
          "fruit",
          "reading",
          "running",
          "upperBody",
          "lowerBody",
          "core",
          "cardio",
          "skill",
          "steps"
        ]
        && request.resource.data.data is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.challengeDate is timestamp;
    }

    function validExerciseSuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "exerciseDefinition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.exerciseDefinition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validLibrarySuggestion() {
      return request.resource.data.keys().hasOnly([
          "submittedBy",
          "challengeEntryId",
          "itemType",
          "definition",
          "status",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.challengeEntryId is string
        && request.resource.data.itemType in ["cardio", "skill"]
        && request.resource.data.definition is map
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == "";
    }

    function validSuggestionReview(entityType, suggestionId) {
      return resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewedAt",
          "reviewedBy",
          "rejectionReason",
          "lastAuditId"
        ])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() <= 500
        && (
          request.resource.data.status == "approved"
          || request.resource.data.rejectionReason.size() >= 4
        )
        && request.resource.data.lastAuditId is string
        && validAuditAfter(
          request.resource.data.lastAuditId,
          entityType,
          suggestionId
        );
    }

    function validAnnouncementData() {
      return request.resource.data.keys().hasOnly([
          "title",
          "summary",
          "body",
          "type",
          "icon",
          "status",
          "featured",
          "version",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "publishedAt",
          "lastAuditId"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 90
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 10
        && request.resource.data.summary.size() <= 220
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 20
        && request.resource.data.body.size() <= 4000
        && request.resource.data.type in [
          "release",
          "feature",
          "challenge",
          "community",
          "maintenance"
        ]
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 8
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.featured is bool
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && (
          request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp
        )
        && (
          request.resource.data.status != "published"
          || (
            request.resource.data.publishedAt is timestamp
            && request.resource.data.publishedAt <= request.time
          )
        )
        && request.resource.data.lastAuditId is string;
    }

    function validAnnouncementCreate(announcementId) {
      return validAnnouncementData()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "announcement",
          announcementId
        );
    }

    function validAnnouncementUpdate(announcementId) {
      return validAnnouncementData()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          resource.data.status != "published"
            && request.resource.data.status == "published"
            ? request.resource.data.publishedAt == request.time
            : request.resource.data.publishedAt == resource.data.publishedAt
        )
        && validAuditAfter(
          request.resource.data.lastAuditId,
          "announcement",
          announcementId
        );
    }

    function validAnnouncementRead(announcementId) {
      return request.resource.data.keys().hasOnly([
          "announcementId",
          "readAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.readAt == request.time;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validUserProfile(userId);
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow update: if (
        isOwner(userId) && validPlayerProfileUpdate()
      ) || (
        isPlatformAdmin() && validAdministratorUserUpdate(userId)
      );
      allow delete: if false;
    }

    match /users/{userId}/library/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validLibraryItem();
      allow update: if isOwner(userId)
        && validLibraryItem()
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /users/{userId}/announcementReads/{announcementId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validAnnouncementRead(announcementId);
      allow delete: if isOwner(userId);
    }

    match /challengeEntries/{entryId} {
      allow create: if signedIn() && validChallengeEntry();
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.status == "published");
      allow create: if isPlatformAdmin()
        && validAnnouncementCreate(announcementId);
      allow update: if isPlatformAdmin()
        && validAnnouncementUpdate(announcementId);
      allow delete: if false;
    }

    match /exerciseSuggestions/{suggestionId} {
      allow create: if signedIn() && validExerciseSuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && validSuggestionReview("exerciseSuggestions", suggestionId);
      allow delete: if false;
    }

    match /librarySuggestions/{suggestionId} {
      allow create: if signedIn() && validLibrarySuggestion();
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow update: if isPlatformAdmin()
        && validSuggestionReview("librarySuggestions", suggestionId);
      allow delete: if false;
    }

    match /auditEvents/{auditId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && validAuditEvent();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
